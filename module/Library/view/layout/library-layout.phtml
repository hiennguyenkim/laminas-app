    <script>
    document.addEventListener('click', function(event) {
        const sidebar = document.getElementById('sidebar');
        const toggleBtn = document.getElementById('toggle-sidebar-btn');
        if (sidebar && sidebar.classList.contains('open') && 
            !sidebar.contains(event.target) && 
            toggleBtn && !toggleBtn.contains(event.target)) {
            sidebar.classList.remove('open');
        }
    });

    const userInitials = <?= json_encode($userInitials) ?>;
    const userAvatarUrl = <?= json_encode($userAvatarUrl) ?>;
    const basePath = <?= json_encode($this->basePath()) ?>;

    function toggleChatbox() {
        const chatbox = document.getElementById('ai-chatbox');
        if (!chatbox) return;
        chatbox.classList.toggle('active');
        if (chatbox.classList.contains('active')) {
            const input = document.getElementById('chatbox-input');
            if (input) input.focus();
        }
    }

    async function sendChat() {
        const input = document.getElementById('chatbox-input');
        if (!input) return;
        const msg = input.value.trim();
        if (!msg) return;

        // Add user msg
        const body = document.getElementById('chatbox-body');
        if (!body) return;
        const userAvatarHtml = userAvatarUrl 
            ? `<img src="${basePath + userAvatarUrl}" class="chat-avatar user-avatar" alt="User">`
            : `<div class="chat-avatar user-avatar">${userInitials}</div>`;
            
        body.innerHTML += `
            <div class="chat-msg-row user">
                ${userAvatarHtml}
                <div class="chat-msg-wrapper">
                    <div class="chat-msg user-msg">${escapeHtml(msg)}</div>
                </div>
            </div>`;
            
        input.value = '';
        body.scrollTop = body.scrollHeight;

        // Show typing
        const typingId = 'typing-' + Date.now();
        body.innerHTML += `
            <div id="${typingId}" class="chat-msg-row ai typing-row">
                <div class="chat-avatar ai-avatar"><i class="bi bi-robot"></i></div>
                <div class="chat-msg-wrapper">
                    <div class="typing-indicator">
                        <div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>
                    </div>
                </div>
            </div>`;
        body.scrollTop = body.scrollHeight;

        try {
            const userId = <?= $authUser ? $authUser['id'] : 'null' ?>;
            const res = await fetch('<?= $this->url('api/books-chat') ?>', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: msg, user_id: userId })
            });
            const data = await res.json();
            
            const typingIndicatorEl = document.getElementById(typingId);
            if (typingIndicatorEl) {
                typingIndicatorEl.remove();
            }

            if (!res.ok) {
                body.innerHTML += `
                    <div class="chat-msg-row ai">
                        <div class="chat-avatar ai-avatar"><i class="bi bi-robot"></i></div>
                        <div class="chat-msg-wrapper">
                            <div class="chat-msg ai-msg chat-msg-error">${escapeHtml(data.error || 'Đã xảy ra lỗi.')}</div>
                        </div>
                    </div>`;
                body.scrollTop = body.scrollHeight;
                return;
            }
            
            let suggestionsHtml = '';
            if (data.suggestions && data.suggestions.length > 0) {
                data.suggestions.forEach(book => {
                    suggestionsHtml += `
                    <div class="book-suggestion" onclick="window.location.href='<?= $this->url('catalog') ?>?search=' + encodeURIComponent('${book.title}')">
                        <div class="suggestion-title"><i class="bi bi-book"></i> ${escapeHtml(book.title)}</div>
                        <div class="suggestion-author">${escapeHtml(book.author)}</div>
                    </div>`;
                });
            }
            
            body.innerHTML += `
                <div class="chat-msg-row ai">
                    <div class="chat-avatar ai-avatar"><i class="bi bi-robot"></i></div>
                    <div class="chat-msg-wrapper">
                        <div class="chat-msg ai-msg">${escapeHtml(data.reply)}</div>
                        ${suggestionsHtml}
                    </div>
                </div>`;
            body.scrollTop = body.scrollHeight;

        } catch (e) {
            const typingIndicatorEl = document.getElementById(typingId);
            if (typingIndicatorEl) {
                typingIndicatorEl.remove();
            }
            body.innerHTML += `
                <div class="chat-msg-row ai">
                    <div class="chat-avatar ai-avatar"><i class="bi bi-robot"></i></div>
                    <div class="chat-msg-wrapper">
                        <div class="chat-msg ai-msg chat-msg-error">Lỗi kết nối. Vui lòng thử lại sau.</div>
                    </div>
                </div>`;
            body.scrollTop = body.scrollHeight;
        }
    }

    function escapeHtml(unsafe) {
        return (unsafe||'').replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }




    // Notifications Toggle & Fetching
    function toggleNotificationsDropdown() {
        const dropdown = document.getElementById('notification-dropdown');
        const isShowing = dropdown.style.display === 'block';
        dropdown.style.display = isShowing ? 'none' : 'block';
        if (!isShowing) {
            loadNotifications();
        }
    }

    // Close notifications dropdown when clicking outside
    document.addEventListener('click', function(event) {
        const bellBtn = document.querySelector('.notification-bell-btn');
        const dropdown = document.getElementById('notification-dropdown');
        if (bellBtn && dropdown && !bellBtn.contains(event.target) && !dropdown.contains(event.target)) {
            dropdown.style.display = 'none';
        }
    });

    let lastNotificationCount = 0;

    function updateNotificationsUI(data, isPush = false) {
        const badge = document.getElementById('notification-badge');
        const countBadge = document.getElementById('notification-count-badge');
        const list = document.getElementById('notification-list');
        if (!badge || !countBadge || !list) return;

        const unreadCount = data.filter(item => item.is_read === 0).length;

        if (unreadCount > 0) {
            badge.textContent = unreadCount;
            badge.style.display = 'flex';
            countBadge.textContent = unreadCount + ' mới';

            // If it's a real-time push and count increased, flash the bell
            if (isPush && unreadCount > lastNotificationCount) {
                const bellBtn = document.querySelector('.noti-bell-btn i');
                if (bellBtn) {
                    bellBtn.classList.add('bi-bell-fill-animated');
                    setTimeout(() => bellBtn.classList.remove('bi-bell-fill-animated'), 2000);
                }
            }
        } else {
            badge.style.display = 'none';
            countBadge.textContent = '0 mới';
        }
        lastNotificationCount = unreadCount;

        const dropdown = document.getElementById('notification-dropdown');
        if (dropdown.style.display === 'block' || !isPush) {
            if (data.length > 0) {
                let html = '';
                data.forEach(item => {
                    let iconClass = 'bi-bell';
                    if (item.type === 'borrow') iconClass = 'bi-book';
                    else if (item.type === 'ticket') iconClass = 'bi-chat-left-text';
                    else if (item.type === 'borrow_approved') iconClass = 'bi-patch-check-fill';
                    else if (item.type === 'ticket_answered') iconClass = 'bi-chat-left-text-fill';
                    else if (item.type === 'borrow_alert') iconClass = 'bi-exclamation-triangle-fill';

                    const readClass = item.is_read ? 'read' : 'unread';

                    html += `
                        <div class="notification-item-wrapper ${readClass}" id="noti-item-${item.id}">
                            <a href="${item.url}" class="notification-item ${item.type}" 
                               onclick="markNotificationRead('${item.id}', '${item.url}', event); return false;">
                                <div class="noti-icon">
                                    <i class="bi ${iconClass}"></i>
                                </div>
                                <div class="noti-content">
                                    <div class="noti-title">${item.title}</div>
                                    <div class="noti-desc">${item.description}</div>
                                    <div class="noti-time">${item.time}</div>
                                </div>
                            </a>
                            <div class="noti-actions">
                                ${!item.is_read ? `
                                <button class="mark-read-btn" onclick="markNotificationReadOnly('${item.id}', event)" title="Đánh dấu đã đọc">
                                    <i class="bi bi-check2"></i>
                                </button>` : ''}
                                <button class="delete-noti-btn" onclick="deleteNotification('${item.id}', event)" title="Xóa thông báo">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </div>
                    `;
                });
                list.innerHTML = html;
            } else {
                list.innerHTML = `
                    <div class="notification-empty noti-empty">
                        <i class="bi bi-bell-slash"></i>
                        Không có thông báo nào mới.
                    </div>
                `;
            }
        }
    }

    async function loadNotifications(isPolling = false) {
        try {
            const response = await fetch('<?= $this->url('api/notifications') ?>');
            if (!response.ok) return;
            const data = await response.json();
            updateNotificationsUI(data, isPolling);
        } catch (e) {
            console.error('Failed to load notifications:', e);
        }
    }

    // Initial load and SSE setup
    window.addEventListener('DOMContentLoaded', () => {
        loadNotifications();

        const userId = <?= $authUser ? $authUser['id'] : 'null' ?>;
        if (userId) {
            const notiSource = new EventSource('<?= $this->url('api/sse-notifications') ?>');
            notiSource.onmessage = (event) => {
                try {
                    const parsedData = JSON.parse(event.data);
                    updateNotificationsUI(parsedData, true);
                } catch (e) {
                    console.error('SSE JSON parse error:', e);
                }
            };
            notiSource.onerror = (e) => {
                console.error('SSE Connection failed. Reconnecting in background...', e);
            };
        }
    });

    async function markNotificationRead(itemId, itemUrl, event) {
        if (event) event.preventDefault();
        try {
            await fetch('<?= $this->url('api/notifications') ?>', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: itemId })
            });
        } catch (e) {
            console.error('Failed to mark notification read:', e);
        }
        window.location.href = itemUrl;
    }

    async function markNotificationReadOnly(itemId, event) {
        if (event) {
            event.stopPropagation();
            event.preventDefault();
        }
        try {
            const response = await fetch('<?= $this->url('api/notifications') ?>', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: itemId })
            });
            if (response.ok) {
                loadNotifications();
            }
        } catch (e) {
            console.error('Failed to mark notification read:', e);
        }
    }

    async function deleteNotification(itemId, event) {
        if (event) {
            event.stopPropagation();
            event.preventDefault();
        }
        if (!confirm('Bạn có chắc chắn muốn xóa thông báo này?')) {
            return;
        }
        console.log('Attempting to delete notification:', itemId);
        try {
            const response = await fetch('<?= $this->url('api/notifications') ?>', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ id: itemId, action: 'delete' })
            });
            const data = await response.json();
            console.log('Delete response:', data);
            if (response.ok) {
                loadNotifications();
            } else {
                alert('Không thể xóa thông báo: ' + (data.error || 'Lỗi không xác định'));
            }
        } catch (e) {
            console.error('Failed to delete notification:', e);
            alert('Lỗi kết nối khi xóa thông báo.');
        }
    }

    async function markAllNotificationsRead(event) {
        if (event) event.preventDefault();
        try {
            const response = await fetch('<?= $this->url('api/notifications') ?>', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({}) // Empty object to trigger mark all
            });
            if (response.ok) {
                loadNotifications();
            }
        } catch (e) {
            console.error('Failed to mark notifications read:', e);
        }
    }

    function clearSearchInput(clearBtn) {
        const input = clearBtn.parentElement.querySelector('input');
        if (input) {
            input.value = '';
            clearBtn.style.display = 'none';
            const form = clearBtn.closest('form');
            if (form) {
                form.submit();
            }
        }
    }
    </script>
</body>
</html>
