<script>
function selectMethod(methodId, methodName, bgCol) {
    // Update active class on selector cards
    document.querySelectorAll('.payment-method-card').forEach(card => {
        card.classList.remove('active');
        const icon = card.querySelector('.check-icon');
        if (icon) icon.style.display = 'none';
    });

    const activeCard = document.getElementById('method-' + methodId);
    activeCard.classList.add('active');
    const activeIcon = activeCard.querySelector('.check-icon');
    if (activeIcon) activeIcon.style.display = 'block';

    // Update labels in checkout details
    document.getElementById('activeMethodLabel').textContent = methodName;
    document.getElementById('activeMethodLabel').style.color = bgCol;

    // Update QR content to match method
    const baseCode = "HDPE_FINE_<?= $fineId ?>";
    const prefix = methodId.toUpperCase();
    document.getElementById('qrContentField').textContent = prefix + "_" + baseCode;

    // Re-generate QR image with new method details
    const textData = "Receiver: HDPE Library; Amount: <?= $amount ?> VND; Code: " + prefix + "_" + baseCode;
    document.getElementById('qrCodeImage').src = "https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=" + encodeURIComponent(textData);
}

// Countdown timer script
let timeRemaining = 600; // 10 minutes in seconds
const timerElement = document.getElementById('timer');

const timerInterval = setInterval(() => {
    if (timeRemaining <= 0) {
        clearInterval(timerInterval);
        timerElement.textContent = "HẾT HẠN";
        timerElement.style.color = "#ef4444";
        document.getElementById('qrCodeImage').style.opacity = "0.2";
        return;
    }

    timeRemaining--;
    const minutes = Math.floor(timeRemaining / 60);
    const seconds = timeRemaining % 60;
    timerElement.textContent = 
        (minutes < 10 ? '0' : '') + minutes + ':' + 
        (seconds < 10 ? '0' : '') + seconds;
}, 1000);
</script>
