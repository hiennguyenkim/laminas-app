<script>
// State Management
let currentChannel = 'momo';
let orderCode = '';
let targetAmount = <?= $amount ?>;
let expirationTime = 0;
let pollingInterval = null;
let countdownInterval = null;

// VietQR Bank Config passed from PHP
const bankId = "<?= $this->escapeJs($bankId) ?>";
const accountNo = "<?= $this->escapeJs($accountNo) ?>";
const accountName = encodeURIComponent("<?= $this->escapeJs($accountName) ?>");

// API Endpoints
const createSessionUrl = "<?= $this->url('api/payment', ['action' => 'create-session']) ?>";
const checkStatusUrl = "<?= $this->url('api/payment', ['action' => 'check-status']) ?>";
const webhookUrl = "<?= $this->url('api/payment', ['action' => 'gmail-webhook']) ?>";

$(document).ready(function() {
    initPayment();
});

function initPayment() {
    // Generate session
    requestPaymentSession(currentChannel);
}

function selectMethod(methodId, methodName, bgCol) {
    if (methodId === currentChannel) return;
    
    // Clear old state
    clearAllIntervals();
    
    currentChannel = methodId;

    // Update active class on selector cards
    document.querySelectorAll('.payment-method-card').forEach(card => {
        card.classList.remove('active');
        const icon = card.querySelector('.check-icon');
        if (icon) icon.style.display = 'none';
    });

    const activeCard = document.getElementById('method-' + methodId);
    activeCard.classList.add('active');
    const activeIcon = activeCard.querySelector('.check-icon');
    if (activeIcon) activeIcon.style.display = 'block';

    // Update labels in checkout details
    document.getElementById('activeMethodLabel').textContent = methodName;
    document.getElementById('activeMethodLabel').style.color = bgCol;
    
    // Set Accent Color Theme
    document.documentElement.style.setProperty('--accent-color', bgCol);

    // Request new session
    requestPaymentSession(methodId);
}

function requestPaymentSession(channel) {
    $('#qrLoading').show();
    $('#qrCodeImage').css('opacity', '0');
    $('#expiredOverlay').hide();
    $('#paidOverlay').hide();
    $('#timer').text('--:--');
    
    fetch(createSessionUrl, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({
            fine_id: <?= $fineId ?>,
            channel: channel
        })
    })
    .then(res => res.json())
    .then(data => {
        $('#qrLoading').hide();
        if (data.status === 'success') {
            orderCode = data.orderCode;
            // Use Unix timestamp (ms) directly to avoid PHP/browser timezone mismatch
            expirationTime = data.expiredAtMs || new Date(data.expiredAt.replace(/-/g, "/")).getTime();
            
            // Build VietQR Dynamic URL
            // Format: https://img.vietqr.io/image/<BANK_ID>-<ACCOUNT_NO>-compact2.png?amount=<AMOUNT>&addInfo=<ORDER_CODE>&accountName=<ACCOUNT_NAME>
            const vietQrUrl = `https://img.vietqr.io/image/${bankId}-${accountNo}-compact2.png?amount=${targetAmount}&addInfo=${orderCode}&accountName=${accountName}`;
            
            $('#qrCodeImage').attr('src', vietQrUrl);
            $('#qrCodeImage').css('opacity', '1');
            $('#qrContentField').text(orderCode);
            
            // Generate mock email in simulator textbox
            const mockEmail = `BIDV: ${new Date().toLocaleString('vi-VN')}. TK: ${accountNo}. Giao dich: +${targetAmount.toLocaleString()} VND. Noi dung: ${orderCode}`;
            $('#simEmailContent').val(mockEmail);

            // Start countdown & polling
            startCountdown();
            startPolling();
        } else {
            alert('Lỗi khởi tạo phiên thanh toán: ' + (data.error || 'Vui lòng thử lại.'));
        }
    })
    .catch(err => {
        $('#qrLoading').hide();
        console.error(err);
    });
}

function startCountdown() {
    if (countdownInterval) clearInterval(countdownInterval);
    
    const timerElement = document.getElementById('timer');
    
    countdownInterval = setInterval(() => {
        const now = new Date().getTime();
        const diff = expirationTime - now;

        if (diff <= 0) {
            clearInterval(countdownInterval);
            clearInterval(pollingInterval);
            timerElement.textContent = "HẾT HẠN";
            timerElement.style.color = "#ef4444";
            $('#expiredOverlay').css('display', 'flex');
            return;
        }

        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);
        
        timerElement.textContent = 
            (minutes < 10 ? '0' : '') + minutes + ':' + 
            (seconds < 10 ? '0' : '') + seconds;
        timerElement.style.color = 'var(--accent-color)';
    }, 1000);
}

function startPolling() {
    if (pollingInterval) clearInterval(pollingInterval);

    pollingInterval = setInterval(() => {
        fetch(`${checkStatusUrl}?orderCode=${orderCode}`)
            .then(res => res.json())
            .then(data => {
                if (data.status === 'success') {
                    if (data.paymentStatus === 'paid') {
                        // Payment Successful
                        clearInterval(pollingInterval);
                        clearInterval(countdownInterval);
                        $('#paidOverlay').css('display', 'flex');
                        
                        // Redirect after 3 seconds
                        setTimeout(() => {
                            window.location.href = "<?= $this->url('student/fine') ?>";
                        }, 3000);
                    } else if (data.paymentStatus === 'expired') {
                        // Expired
                        clearInterval(pollingInterval);
                        clearInterval(countdownInterval);
                        document.getElementById('timer').textContent = "HẾT HẠN";
                        $('#expiredOverlay').css('display', 'flex');
                    }
                }
            })
            .catch(err => console.error(err));
    }, 3000);
}

function recreateSession() {
    $('#expiredOverlay').hide();
    requestPaymentSession(currentChannel);
}

/**
 * One-click payment confirmation — uses the simulator endpoint.
 * Works in dev/demo environments where Gmail Pub/Sub is not set up.
 */
function confirmPayment() {
    if (!orderCode) {
        $('#confirmBtnFeedback').css('color', '#ef4444').text('Chưa có mã phiên. Vui lòng chờ QR tải xong.');
        return;
    }

    const emailBody = $('#simEmailContent').val();
    if (!emailBody || !emailBody.trim()) {
        $('#confirmBtnFeedback').css('color', '#ef4444').text('Nội dung xác nhận chưa sẵn sàng. Thử tải lại trang.');
        return;
    }

    $('#confirmBtnSpinner').show();
    $('#confirmBtnIcon').hide();
    $('#confirmBtnLabel').text('Đang xác nhận...');
    $('#confirmPayBtn').prop('disabled', true);
    $('#confirmBtnFeedback').text('');

    fetch(webhookUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ simulate_email_body: emailBody })
    })
    .then(res => res.json())
    .then(data => {
        $('#confirmBtnSpinner').hide();
        $('#confirmBtnIcon').show();
        if (data.status === 'success' && data.processedCodes && data.processedCodes.length > 0) {
            $('#confirmPayBtn').css('background', 'linear-gradient(135deg, #059669, #047857)');
            $('#confirmBtnLabel').text('Đã xác nhận! Đang cập nhật...');
            $('#confirmBtnFeedback').css('color', '#10b981').text('✓ Giao dịch hợp lệ — trang sẽ tự cập nhật trong giây lát.');
        } else if (data.processedCodes && data.processedCodes.length === 0) {
            $('#confirmBtnLabel').text('Tôi đã chuyển khoản xong');
            $('#confirmPayBtn').prop('disabled', false);
            $('#confirmBtnFeedback').css('color', '#f59e0b').html('<i class="bi bi-exclamation-triangle"></i> Không khớp mã hoặc số tiền. Kiểm tra lại nội dung chuyển khoản đúng với mã QR.');
        } else {
            $('#confirmBtnLabel').text('Tôi đã chuyển khoản xong');
            $('#confirmPayBtn').prop('disabled', false);
            $('#confirmBtnFeedback').css('color', '#ef4444').text('Lỗi xác nhận: ' + (data.error || 'Thử lại sau.'));
        }
    })
    .catch(err => {
        $('#confirmBtnSpinner').hide();
        $('#confirmBtnIcon').show();
        $('#confirmBtnLabel').text('Tôi đã chuyển khoản xong');
        $('#confirmPayBtn').prop('disabled', false);
        $('#confirmBtnFeedback').css('color', '#ef4444').text('Lỗi kết nối. Vui lòng thử lại.');
    });
}

function triggerSimulatedWebhook() {
    const emailBody = $('#simEmailContent').val();
    if (!emailBody.trim()) {
        alert('Vui lòng nhập nội dung email giả lập.');
        return;
    }

    $('#simBtnSpinner').show();
    $('#simResponseStatus').text('');
    
    fetch(webhookUrl, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({
            simulate_email_body: emailBody
        })
    })
    .then(res => res.json())
    .then(data => {
        $('#simBtnSpinner').hide();
        if (data.status === 'success') {
            $('#simResponseStatus').css('color', '#10b981').html('<i class="bi bi-check-circle"></i> Đã kích hoạt webhook! Mã khớp: ' + (data.processedCodes.join(', ') || 'Không khớp'));
        } else {
            $('#simResponseStatus').css('color', '#ef4444').text('Lỗi Webhook: ' + (data.error || 'Thử lại'));
        }
    })
    .catch(err => {
        $('#simBtnSpinner').hide();
        $('#simResponseStatus').css('color', '#ef4444').text('Lỗi kết nối Webhook.');
        console.error(err);
    });
}

function copyContent() {
    const content = $('#qrContentField').text();
    navigator.clipboard.writeText(content).then(() => {
        const btn = $('.copy-btn');
        btn.html('<i class="bi bi-check"></i>').css('background', '#10b981');
        setTimeout(() => {
            btn.html('<i class="bi bi-clipboard"></i>').css('background', '');
        }, 1500);
    });
}

function clearAllIntervals() {
    if (pollingInterval) clearInterval(pollingInterval);
    if (countdownInterval) clearInterval(countdownInterval);
}

// Ensure cleanup on page exit
window.onbeforeunload = function() {
    clearAllIntervals();
};
</script>
