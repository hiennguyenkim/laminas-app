<script>
// State Management
let currentChannel = 'momo';
let orderCode = '';
let targetAmount = <?= $amount ?>;
let expirationTime = 0;
let pollingInterval = null;
let countdownInterval = null;
let qrCodeInstance = null;

// VietQR Bank Config passed from PHP
const bankId = "<?= $this->escapeJs($bankId) ?>";
const accountNo = "<?= $this->escapeJs($accountNo) ?>";
const accountName = "<?= $this->escapeJs($accountName) ?>";

// API Endpoints
const createSessionUrl = "<?= $this->url('api/payment', ['action' => 'create-session']) ?>";
const checkStatusUrl = "<?= $this->url('api/payment', ['action' => 'check-status']) ?>";
const webhookUrl = "<?= $this->url('api/payment', ['action' => 'gmail-webhook']) ?>";

// Bank code mapping dictionary
const bankBinMap = {
    'BIDV': '970418',
    'VCB': '970436',
    'VIETCOMBANK': '970436',
    'CTG': '970415',
    'VIETINBANK': '970415',
    'TCB': '970407',
    'TECHCOMBANK': '970407',
    'MB': '970422',
    'MBBANK': '970422',
    'VBA': '970405',
    'AGRIBANK': '970405',
    'ACB': '970416',
    'VPB': '970432',
    'VPBANK': '970432',
    'STB': '970403',
    'SACOMBANK': '970403',
    'TPB': '970423',
    'TPBANK': '970423',
    'SHB': '970443',
    'HDB': '970437',
    'HDBANK': '970437',
    'VIB': '970441',
    'MSB': '970426'
};

function getBankBin(bankName) {
    const key = bankName.toUpperCase().replace(/[^A-Z0-9]/g, '');
    return bankBinMap[key] || '970418'; // Fallback to BIDV if not found
}

function calculateCRC16(str) {
    let crc = 0xFFFF;
    const poly = 0x1021;
    for (let i = 0; i < str.length; i++) {
        let code = str.charCodeAt(i);
        crc ^= (code << 8);
        for (let j = 0; j < 8; j++) {
            if ((crc & 0x8000) !== 0) {
                crc = ((crc << 1) ^ poly) & 0xFFFF;
            } else {
                crc = (crc << 1) & 0xFFFF;
            }
        }
    }
    let hex = crc.toString(16).toUpperCase();
    return hex.padStart(4, '0');
}

const padVal = (val) => val.toString().length.toString().padStart(2, '0');

function generateVietQrString(bankId, accountNo, amount, orderCode) {
    const bin = getBankBin(bankId);
    
    // Sub-tag 01 details:
    // Sub-tag 00: Bank Code (BIN)
    const sub00 = `0006${bin}`;
    // Sub-tag 01: Account Number
    const sub01 = `01${padVal(accountNo)}${accountNo}`;
    const accountInfo = sub00 + sub01;
    
    // Tag 38 details:
    // Sub-tag 00: GUID
    const tag38Sub00 = `0010A000000727`;
    // Sub-tag 01: Account Info Template
    const tag38Sub01 = `01${padVal(accountInfo)}${accountInfo}`;
    // Sub-tag 02: Service Code
    const tag38Sub02 = `0208QRIBFTTA`;
    
    const tag38Content = tag38Sub00 + tag38Sub01 + tag38Sub02;
    const tag38 = `38${padVal(tag38Content)}${tag38Content}`;
    
    // Tag 62 (Additional Data Field Template)
    const tag62Sub08 = `08${padVal(orderCode)}${orderCode}`;
    const tag62 = `62${padVal(tag62Sub08)}${tag62Sub08}`;
    
    // Main Payload
    let payload = 
        `000201` +                  // Format Indicator
        `010212` +                  // Point of Initiation (12 = Dynamic)
        tag38 +                     // Merchant Account Info
        `5303704` +                 // Currency (VND = 704)
        `54${padVal(amount)}${amount}` + // Amount
        `5802VN` +                  // Country Code
        tag62 +                     // Additional Data (Description)
        `6304`;                     // CRC Tag and placeholder length
        
    const crc = calculateCRC16(payload);
    return payload + crc;
}

function renderQrCode(qrData) {
    $('#qrCodeDiv').html(''); // Clear previous QR
    qrCodeInstance = new QRCode(document.getElementById("qrCodeDiv"), {
        text: qrData,
        width: 200,
        height: 200,
        colorDark : "#000000",
        colorLight : "#ffffff",
        correctLevel : QRCode.CorrectLevel.M
    });
    // Fade in
    $('#qrLoading').hide();
    $('#qrCodeDiv').css('opacity', '1');
}

// Trigger payment initialization eagerly
initPayment();

function initPayment() {
    // Set default accent color for Momo
    document.documentElement.style.setProperty('--accent-color', '#a50064');
    // Generate session
    requestPaymentSession(currentChannel);
}

function selectMethod(methodId, methodName, bgCol) {
    if (methodId === currentChannel) return;
    
    // Clear old state
    clearAllIntervals();
    
    currentChannel = methodId;

    // Update active class on selector cards
    document.querySelectorAll('.payment-method-card').forEach(card => {
        card.classList.remove('active');
        const icon = card.querySelector('.check-icon');
        if (icon) icon.style.display = 'none';
    });

    const activeCard = document.getElementById('method-' + methodId);
    activeCard.classList.add('active');
    const activeIcon = activeCard.querySelector('.check-icon');
    if (activeIcon) activeIcon.style.display = 'block';

    // Update labels in checkout details
    document.getElementById('activeMethodLabel').textContent = methodName;
    document.getElementById('activeMethodLabel').style.color = bgCol;
    
    // Set Accent Color Theme
    document.documentElement.style.setProperty('--accent-color', bgCol);

    // Request new session
    requestPaymentSession(methodId);
}

function requestPaymentSession(channel) {
    $('#qrLoading').html('<div class="spinner-border spinner-border-sm" role="status"></div> Đang khởi tạo...').show();
    $('#qrCodeDiv').css('opacity', '0').html('');
    $('#expiredOverlay').hide();
    $('#paidOverlay').hide();
    $('#failedOverlay').hide();
    $('#timer').text('--:--');
    $('#qrContentFieldMain').text('---');
    
    fetch(createSessionUrl, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({
            fine_id: <?= $fineId ?>,
            channel: channel
        })
    })
    .then(res => res.json())
    .then(data => {
        if (data.status === 'success') {
            orderCode = data.orderCode;
            // Use Unix timestamp (ms) directly to avoid PHP/browser timezone mismatch
            expirationTime = data.expiredAtMs || new Date(data.expiredAt.replace(/-/g, "/")).getTime();
            
            // Build VietQR Dynamic EMVCo string locally
            const qrString = generateVietQrString(bankId, accountNo, targetAmount, orderCode);
            
            // Render QR Code instantly using the local library
            renderQrCode(qrString);
            
            $('#qrContentField').text(orderCode);
            $('#qrContentFieldMain').text(orderCode);

            // Start countdown & polling
            startCountdown();
            startPolling();
        } else {
            $('#qrLoading').hide();
            alert('Lỗi khởi tạo phiên thanh toán: ' + (data.error || 'Vui lòng thử lại.'));
        }
    })
    .catch(err => {
        $('#qrLoading').hide();
        console.error(err);
    });
}

function startCountdown() {
    if (countdownInterval) clearInterval(countdownInterval);
    
    const timerElement = document.getElementById('timer');
    
    countdownInterval = setInterval(() => {
        const now = new Date().getTime();
        const diff = expirationTime - now;

        if (diff <= 0) {
            clearInterval(countdownInterval);
            clearInterval(pollingInterval);
            timerElement.textContent = "HẾT HẠN";
            timerElement.style.color = "#ef4444";
            $('#expiredOverlay').css('display', 'flex');
            return;
        }

        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);
        
        timerElement.textContent = 
            (minutes < 10 ? '0' : '') + minutes + ':' + 
            (seconds < 10 ? '0' : '') + seconds;
        timerElement.style.color = 'var(--accent-color)';
    }, 1000);
}

function startPolling() {
    if (pollingInterval) clearInterval(pollingInterval);

    pollingInterval = setInterval(() => {
        fetch(`${checkStatusUrl}?orderCode=${orderCode}`)
            .then(res => res.json())
            .then(data => {
                if (data.status === 'success') {
                    if (data.paymentStatus === 'paid') {
                        // Payment Successful
                        clearInterval(pollingInterval);
                        clearInterval(countdownInterval);
                        $('#paidOverlay').css('display', 'flex');
                        
                        // Redirect after 3 seconds
                        setTimeout(() => {
                            window.location.href = "<?= $this->url('student/fine') ?>";
                        }, 3000);
                    } else if (data.paymentStatus === 'expired') {
                        // Expired
                        clearInterval(pollingInterval);
                        clearInterval(countdownInterval);
                        document.getElementById('timer').textContent = "HẾT HẠN";
                        $('#expiredOverlay').css('display', 'flex');
                    } else if (data.paymentStatus === 'failed') {
                        // Amount mismatch / Failed
                        clearInterval(pollingInterval);
                        clearInterval(countdownInterval);
                        $('#failedOverlay').css('display', 'flex');
                    }
                }
            })
            .catch(err => console.error(err));
    }, 3000);
}

function recreateSession() {
    $('#expiredOverlay').hide();
    $('#failedOverlay').hide();
    requestPaymentSession(currentChannel);
}

/**
 * One-click payment confirmation — queries check-status directly.
 */
function confirmPayment() {
    if (!orderCode) {
        $('#confirmBtnFeedback').css('color', '#ef4444').text('Chưa có mã phiên. Vui lòng chờ QR tải xong.');
        return;
    }

    $('#confirmBtnSpinner').show();
    $('#confirmBtnIcon').hide();
    $('#confirmBtnLabel').text('Đang xác nhận...');
    $('#confirmPayBtn').prop('disabled', true);
    $('#confirmBtnFeedback').text('');

    fetch(`${checkStatusUrl}?orderCode=${orderCode}`)
    .then(res => res.json())
    .then(data => {
        $('#confirmBtnSpinner').hide();
        $('#confirmBtnIcon').show();
        $('#confirmPayBtn').prop('disabled', false);
        $('#confirmBtnLabel').text('Tôi đã chuyển khoản xong');

        if (data.status === 'success') {
            if (data.paymentStatus === 'paid') {
                $('#paidOverlay').css('display', 'flex');
                setTimeout(() => {
                    window.location.href = "<?= $this->url('student/fine') ?>";
                }, 3000);
            } else if (data.paymentStatus === 'failed') {
                clearInterval(pollingInterval);
                clearInterval(countdownInterval);
                $('#failedOverlay').css('display', 'flex');
            } else {
                $('#confirmBtnFeedback').css('color', '#f59e0b').text('Giao dịch chưa được ghi nhận trên hệ thống. Vui lòng chờ từ 1-3 phút hoặc kiểm tra lại.');
            }
        } else {
            $('#confirmBtnFeedback').css('color', '#ef4444').text('Lỗi xác nhận: ' + (data.error || 'Thử lại sau.'));
        }
    })
    .catch(err => {
        $('#confirmBtnSpinner').hide();
        $('#confirmBtnIcon').show();
        $('#confirmPayBtn').prop('disabled', false);
        $('#confirmBtnLabel').text('Tôi đã chuyển khoản xong');
        $('#confirmBtnFeedback').css('color', '#ef4444').text('Lỗi kết nối. Vui lòng thử lại.');
    });
}

function copyContent() {
    const content = $('#qrContentField').text();
    navigator.clipboard.writeText(content).then(() => {
        const btn = $('.copy-btn');
        btn.html('<i class="bi bi-check"></i>').css('background', '#10b981');
        setTimeout(() => {
            btn.html('<i class="bi bi-clipboard"></i>').css('background', '');
        }, 1500);
    });
}

function copyContentMain() {
    const content = $('#qrContentFieldMain').text();
    if (!content || content === '---') return;
    navigator.clipboard.writeText(content).then(() => {
        const btn = $('#copyBtnMain');
        const icon = $('#copyIconMain');
        const text = $('#copyTextMain');
        
        btn.css('background', '#10b981');
        icon.attr('class', 'bi bi-check-lg');
        text.text('Đã sao chép');
        
        setTimeout(() => {
            btn.css('background', 'var(--accent-color, #a50064)');
            icon.attr('class', 'bi bi-clipboard');
            text.text('Sao chép');
        }, 1500);
    });
}

function clearAllIntervals() {
    if (pollingInterval) clearInterval(pollingInterval);
    if (countdownInterval) clearInterval(countdownInterval);
}

// Ensure cleanup on page exit
window.onbeforeunload = function() {
    clearAllIntervals();
};
</script>
