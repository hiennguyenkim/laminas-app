$perPage    = (int) ($pagination['perPage'] ?? 20);
$totalItems = (int) ($pagination['totalItems'] ?? 0);
$totalPages = (int) ($pagination['totalPages'] ?? 1);

$queryBase = [
    'search'    => $filterSearch,
    'status'    => $filterStatus,
    'sort'      => $filters['sort'] ?? 'created_at',
    'direction' => $filters['direction'] ?? 'DESC',
];

$buildPageUrl = function(int $p) use ($queryBase, $routePrefix): string {
    $q = $queryBase; $q['page'] = $p;
    $q = array_filter($q, fn($v) => $v !== null && $v !== '');
    return $this->url($routePrefix, [], ['query' => $q]);
};

$buildSortUrl = function(string $col) use ($queryBase, $routePrefix): string {
    $currentSort = $queryBase['sort'];
    $currentDir  = strtoupper($queryBase['direction']);
    if ($currentSort === $col) {
        $newDir = ($currentDir === 'ASC') ? 'DESC' : 'ASC';
    } else {
        $newDir = ($col === 'amount') ? 'DESC' : 'ASC';
    }
    $q = $queryBase;
    $q['sort'] = $col;
    $q['direction'] = $newDir;
    $q = array_filter($q, fn($v) => $v !== null && $v !== '');
    return $this->url($routePrefix, [], ['query' => $q]);
};

$renderSortIcon = function(string $col) use ($queryBase): string {
    $currentSort = $queryBase['sort'];
    $currentDir  = strtoupper($queryBase['direction']);
    if ($currentSort !== $col) {
        return '<i class="bi bi-arrow-down-up ms-1" style="font-size: 0.75rem; opacity: 0.4;"></i>';
    }
    if ($currentDir === 'ASC') {
        return '<i class="bi bi-sort-down ms-1" style="font-size: 0.85rem; color: var(--accent-purple);"></i>';
    }
    return '<i class="bi bi-sort-up ms-1" style="font-size: 0.85rem; color: var(--accent-purple);"></i>';
};
