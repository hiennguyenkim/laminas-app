<script>

function previewAvatar(input) {
    const file = input.files[0];
    if (!file) return;
    if (file.size > 2 * 1024 * 1024) { alert('File quá lớn. Tối đa 2MB.'); input.value = ''; return; }
    const allowed = ['image/png','image/jpeg','image/webp','image/gif'];
    if (!allowed.includes(file.type)) { alert('Định dạng không hỗ trợ. Chỉ chấp nhận PNG, JPG, WEBP, GIF.'); input.value = ''; return; }
    const reader = new FileReader();
    reader.onload = e => {
        const img = document.getElementById('avatar-preview-img');
        const ph  = document.getElementById('avatar-placeholder');
        if (img) {
            img.src = e.target.result;
            img.classList.remove('d-none');
            img.style.display = 'block';
        }
        if (ph) {
            ph.classList.add('d-none');
            ph.style.display = 'none';
        }
        const dz = document.getElementById('avatar-drop-zone');
        if (dz) {
            dz.style.borderColor = 'var(--primary-color)';
        }
    };
    reader.readAsDataURL(file);
}
document.addEventListener('DOMContentLoaded', () => {
    const dropZone = document.getElementById('avatar-drop-zone');
    if (!dropZone) return;
    ['dragenter','dragover'].forEach(e => dropZone.addEventListener(e, ev => {
        ev.preventDefault(); dropZone.style.background = 'rgba(124,106,255,.08)'; dropZone.style.borderColor = 'var(--primary-color)';
    }));
    ['dragleave','drop'].forEach(e => dropZone.addEventListener(e, ev => {
        ev.preventDefault(); dropZone.style.background = ''; dropZone.style.borderColor = '';
    }));
    dropZone.addEventListener('drop', e => {
        const input = document.getElementById('avatar-input');
        if (input) {
            input.files = e.dataTransfer.files;
            previewAvatar(input);
        }
    });
});
</script>
