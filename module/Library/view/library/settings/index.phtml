<script>
function previewLogo(input) {
    const file = input.files[0];
    if (!file) return;
    if (file.size > 2 * 1024 * 1024) { alert('File quá lớn. Tối đa 2MB.'); input.value = ''; return; }
    const allowed = ['image/png','image/jpeg','image/svg+xml','image/webp'];
    if (!allowed.includes(file.type)) { alert('Định dạng không hỗ trợ. Chỉ chấp nhận PNG, JPG, SVG, WEBP.'); input.value = ''; return; }
    const reader = new FileReader();
    reader.onload = e => {
        const img = document.getElementById('logo-preview-img');
        const ph  = document.getElementById('logo-placeholder');
        img.src = e.target.result;
        img.style.display = 'block';
        if (ph) ph.style.display = 'none';
        document.getElementById('logo-drop-zone').style.borderColor = 'var(--accent-purple)';
        document.getElementById('logo-submit-btn').style.display = 'block';
    };
    reader.readAsDataURL(file);
}

document.addEventListener('DOMContentLoaded', () => {
    // Logo Drop Zone events
    const dropZone = document.getElementById('logo-drop-zone');
    if (dropZone) {
        ['dragenter','dragover'].forEach(e => dropZone.addEventListener(e, ev => {
            ev.preventDefault(); dropZone.style.background = 'rgba(139,92,246,.08)'; dropZone.style.borderColor = 'var(--accent-purple)';
        }));
        ['dragleave','drop'].forEach(e => dropZone.addEventListener(e, ev => {
            ev.preventDefault(); dropZone.style.background = '';
        }));
        dropZone.addEventListener('drop', e => {
            document.getElementById('logo-input').files = e.dataTransfer.files;
            previewLogo(document.getElementById('logo-input'));
        });
    }

    // Maintenance Mode script
    const wrap = document.getElementById('maintenance_until_wrap');
    const picker = document.getElementById('maintenance_until');
    const mForm = document.getElementById('maintenance-form');
    const mStateInput = document.getElementById('maintenance_mode_state');

    const mCard = document.getElementById('maintenance-card');
    const mStatusBadge = document.getElementById('maintenance-status-badge');
    const mAlertBanner = document.getElementById('maintenance-alert-banner');
    const mAlertIcon = document.getElementById('maintenance-alert-icon');
    const mAlertTitle = document.getElementById('maintenance-alert-title');
    const mAlertDesc = document.getElementById('maintenance-alert-desc');
    
    const mActionBtn = document.getElementById('maintenance-action-btn');
    const mUpdateBtn = document.getElementById('maintenance-update-btn');
    const mCancelBtn = document.getElementById('maintenance-cancel-btn');

    // Is the system currently in maintenance mode based on PHP initial state?
    const isCurrentlyMaintenance = <?= $maintenanceMode === '1' ? 'true' : 'false' ?>;

    if (isCurrentlyMaintenance) {
        // --- Flow when system is CURRENTLY IN MAINTENANCE MODE ---
        if (mActionBtn) {
            mActionBtn.addEventListener('click', () => {
                if (confirm('Bạn có chắc chắn muốn tắt chế độ bảo trì và mở công khai website ngay lập tức?')) {
                    if (mStateInput) {
                        mStateInput.disabled = true; // Disable parameter so controller sets isset to false
                    }
                    mForm.submit();
                }
            });
        }

        if (mUpdateBtn && picker) {
            mUpdateBtn.addEventListener('click', () => {
                if (!picker.value) {
                    alert('Vui lòng thiết lập thời gian kết thúc bảo trì.');
                    return;
                }
                const selectedTime = new Date(picker.value).getTime();
                const nowTime = new Date().getTime();
                if (selectedTime <= nowTime) {
                    alert('Thời gian kết thúc bảo trì phải ở tương lai.');
                    return;
                }

                // Format friendly date time string for confirmation
                const dateStr = new Date(picker.value).toLocaleString('vi-VN', {
                    hour: '2-digit',
                    minute: '2-digit',
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric'
                });

                if (confirm(`Bạn có chắc chắn muốn cập nhật thời gian hoàn thành bảo trì đến: ${dateStr}?`)) {
                    if (mStateInput) {
                        mStateInput.disabled = false;
                        mStateInput.value = '1';
                    }
                    mForm.submit();
                }
            });
        }
    } else {
        // --- Flow when system is CURRENTLY PUBLIC / INACTIVE ---
        if (mActionBtn) {
            mActionBtn.addEventListener('click', () => {
                // Show datetime picker wrap
                if (wrap) wrap.style.display = 'block';
                if (picker) {
                    picker.required = true;
                    if (!picker.value) {
                        const now = new Date();
                        now.setHours(now.getHours() + 1);
                        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
                        picker.value = now.toISOString().slice(0, 16);
                    }
                    picker.focus();
                }

                // Toggle buttons visibility
                mActionBtn.style.display = 'none';
                if (mUpdateBtn) mUpdateBtn.style.display = 'flex';
                if (mCancelBtn) mCancelBtn.style.display = 'flex';

                // Real-time Visual Preview of Maintenance Glow
                if (mStatusBadge) {
                    mStatusBadge.className = 'badge badge-orange';
                    mStatusBadge.innerHTML = '<i class="bi bi-clock"></i> Chuẩn bị bảo trì';
                }
                if (mCard) {
                    mCard.style.borderColor = 'rgba(249, 115, 22, 0.4)';
                    mCard.style.boxShadow = '0 4px 20px rgba(249, 115, 22, 0.08)';
                }
                if (mAlertBanner) {
                    mAlertBanner.className = 'alert alert-warning';
                    mAlertBanner.style.background = 'rgba(249, 115, 22, 0.08)';
                    mAlertBanner.style.borderColor = 'rgba(249, 115, 22, 0.2)';
                }
                if (mAlertIcon) {
                    mAlertIcon.className = 'bi bi-exclamation-triangle-fill text-warning';
                }
                if (mAlertTitle) {
                    mAlertTitle.textContent = 'Thiết lập thời gian bảo trì';
                    mAlertTitle.style.color = 'var(--accent-orange)';
                }
                if (mAlertDesc) {
                    mAlertDesc.textContent = 'Vui lòng chọn thời điểm dự kiến hoàn thành bên dưới để tạm khóa toàn bộ website đối với độc giả thông thường.';
                }
            });
        }

        if (mCancelBtn) {
            mCancelBtn.addEventListener('click', () => {
                // Hide datetime picker wrap
                if (wrap) wrap.style.display = 'none';
                if (picker) picker.required = false;

                // Toggle buttons visibility back
                mActionBtn.style.display = 'flex';
                if (mUpdateBtn) mUpdateBtn.style.display = 'none';
                if (mCancelBtn) mCancelBtn.style.display = 'none';

                // Reset visual states to public operating state
                if (mStatusBadge) {
                    mStatusBadge.className = 'badge badge-green';
                    mStatusBadge.innerHTML = '<i class="bi bi-check-circle-fill"></i> Đang hoạt động';
                }
                if (mCard) {
                    mCard.style.borderColor = '';
                    mCard.style.boxShadow = '';
                }
                if (mAlertBanner) {
                    mAlertBanner.className = 'alert alert-success';
                    mAlertBanner.style.background = 'rgba(16, 185, 129, 0.08)';
                    mAlertBanner.style.borderColor = 'rgba(16, 185, 129, 0.2)';
                }
                if (mAlertIcon) {
                    mAlertIcon.className = 'bi bi-check-circle-fill text-success';
                }
                if (mAlertTitle) {
                    mAlertTitle.textContent = 'Hệ thống đang mở công khai';
                    mAlertTitle.style.color = '#10b981';
                }
                if (mAlertDesc) {
                    mAlertDesc.textContent = 'Tất cả người dùng, độc giả và khách truy cập có thể truy cập hệ thống và thực hiện các chức năng mượn/trả sách bình thường.';
                }
            });
        }

        if (mUpdateBtn && picker) {
            mUpdateBtn.addEventListener('click', () => {
                if (!picker.value) {
                    alert('Vui lòng thiết lập thời gian kết thúc bảo trì.');
                    return;
                }
                const selectedTime = new Date(picker.value).getTime();
                const nowTime = new Date().getTime();
                if (selectedTime <= nowTime) {
                    alert('Thời gian kết thúc bảo trì phải ở tương lai.');
                    return;
                }

                const dateStr = new Date(picker.value).toLocaleString('vi-VN', {
                    hour: '2-digit',
                    minute: '2-digit',
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric'
                });

                if (confirm(`Xác nhận kích hoạt chế độ bảo trì hệ thống?\nToàn bộ website sẽ bị tạm khóa cho đến: ${dateStr}`)) {
                    if (mStateInput) {
                        mStateInput.disabled = false;
                        mStateInput.value = '1';
                    }
                    mForm.submit();
                }
            });
        }
    }
});
</script>
