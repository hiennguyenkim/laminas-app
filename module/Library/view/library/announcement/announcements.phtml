<script>
document.addEventListener('DOMContentLoaded', () => {
    let catalogChatInterval = null;
    const currentUserId = parseInt(<?= json_encode($authUser['id'] ?? 0) ?>);
    const basePath = <?= json_encode($this->basePath()) ?>;
    const container = document.getElementById('catalog-chat-body');
    const isGuest = <?= json_encode((bool) $isGuest) ?>;

    let allMessages = [];
    let oldestMessageId = null;
    let newestMessageId = null;
    let isLoadingOlder = false;
    let hasMoreOlder = true;

    function escapeHtml(unsafe) {
        return (unsafe || '').replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }

    function isScrolledToBottom() {
        if (!container) return false;
        return container.scrollHeight - container.clientHeight - container.scrollTop < 50;
    }

    function scrollToBottom() {
        if (container) {
            container.scrollTop = container.scrollHeight;
        }
    }

    function renderReactionsHtml(msgId, msgReactions) {
        let html = '';
        const emojis = Object.keys(msgReactions);
        if (emojis.length > 0) {
            html += `<div class="forum-msg-reactions">`;
            emojis.forEach(emoji => {
                const userIds = msgReactions[emoji] || [];
                if (userIds.length > 0) {
                    const hasReacted = userIds.includes(currentUserId);
                    const activeClass = hasReacted ? 'active' : '';
                    html += `<span class="forum-reaction-badge ${activeClass}" onclick="reactCatalogMessage(${msgId}, '${emoji}')">
                        ${emoji} ${userIds.length}
                    </span>`;
                }
            });
            html += `</div>`;
        }
        return html;
    }

    window.toggleReactionPicker = function(event, msgId) {
        event.stopPropagation();
        const existing = document.querySelector('.forum-react-picker');
        if (existing) {
            existing.remove();
        }
        
        const btn = event.currentTarget;
        const picker = document.createElement('div');
        picker.className = 'forum-react-picker';
        const emojis = ['👍', '❤️', '😂', '😮', '😢'];
        emojis.forEach(emoji => {
            const emojiSpan = document.createElement('span');
            emojiSpan.className = 'forum-react-picker-emoji';
            emojiSpan.innerText = emoji;
            emojiSpan.onclick = function(e) {
                e.stopPropagation();
                reactCatalogMessage(msgId, emoji);
                picker.remove();
            };
            picker.appendChild(emojiSpan);
        });
        btn.appendChild(picker);
    };

    document.addEventListener('click', function() {
        const existing = document.querySelector('.forum-react-picker');
        if (existing) {
            existing.remove();
        }
    });

    window.reactCatalogMessage = async function(msgId, emoji) {
        const chatUrl = '<?= $this->url("student/dashboard", ["action" => "chat"]) ?>';
        await fetch(chatUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `action=react&id=${msgId}&emoji=${encodeURIComponent(emoji)}`
        });
        pollNewMessages();
    };

    function renderMessageRow(msg) {
        const colors = ['#7c6aff','#f97316','#22c55e','#3b82f6','#ec4899','#14b8a6'];
        let hash = 0;
        const usernameStr = msg.nickname || '';
        for (let i = 0; i < usernameStr.length; i++) hash = usernameStr.charCodeAt(i) + ((hash << 5) - hash);
        const avatarColor = colors[Math.abs(hash) % colors.length];
        const initial = usernameStr.substring(0, 1).toUpperCase() || '?';
        const roleBadge = msg.role === 'admin' ? '<span class="badge badge-purple forum-role-badge">Thủ thư</span>' : '';
        
        const deleteBtn = (!isGuest && parseInt(msg.user_id) === currentUserId) ? `<span onclick="deleteCatalogMessage(${msg.id})" class="forum-msg-delete" title="Xóa"><i class="bi bi-trash"></i></span>` : '';
        const reactBtn = (!isGuest && currentUserId > 0) ? `<span class="forum-msg-react-btn" title="Thả cảm xúc" onclick="toggleReactionPicker(event, ${msg.id})"><i class="bi bi-emoji-smile"></i></span>` : '';
        
        const avatarUrl = msg.avatar_url || '';
        const avatarSrc = (avatarUrl.startsWith('http://') || avatarUrl.startsWith('https://')) ? avatarUrl : (basePath + avatarUrl);
        const avatarHtml = avatarUrl ? `<img src="${avatarSrc}" class="forum-msg-avatar" style="object-fit: cover;">` : `<div style="background:${avatarColor}" class="forum-msg-avatar">${initial}</div>`;

        let msgReactions = {};
        if (msg.reactions) {
            try {
                msgReactions = JSON.parse(msg.reactions);
            } catch (e) {
                msgReactions = {};
            }
        }

        return `<div class="forum-msg-row" data-msg-id="${msg.id}">
            ${avatarHtml}
            <div class="forum-msg-body">
                <div class="forum-msg-meta">
                    <span class="forum-msg-username">${escapeHtml(msg.nickname)}${roleBadge}</span>
                    <span class="forum-msg-time">${msg.created_at}${msg.date_label || ''}</span>
                    <div class="forum-msg-meta-actions">${reactBtn}${deleteBtn}</div>
                </div>
                <div class="forum-msg-text">${escapeHtml(msg.message)}</div>
                <div class="forum-msg-reactions-wrapper">
                    ${renderReactionsHtml(msg.id, msgReactions)}
                </div>
            </div>
        </div>`;
    }

    function displayMessages(messages, append = true, prepend = false) {
        if (!container || messages.length === 0) return;
        
        let html = '';
        messages.forEach(msg => {
            html += renderMessageRow(msg);
        });

        if (prepend) {
            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = html;
            while (tempDiv.lastChild) {
                container.insertBefore(tempDiv.lastChild, container.firstChild);
            }
        } else if (append) {
            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = html;
            while (tempDiv.firstChild) {
                container.appendChild(tempDiv.firstChild);
            }
        } else {
            container.innerHTML = html;
        }
    }

    async function loadInitialMessages() {
        if (!container) return;
        try {
            const response = await fetch('<?= $this->url("student/dashboard", ["action" => "chat"]) ?>');
            if (!response.ok) return;
            const data = await response.json();
            const messages = data.messages || [];
            
            const pinnedBanner = document.getElementById('forum-pinned-banner');
            const pinnedText = document.getElementById('forum-pinned-text');
            if (pinnedBanner && pinnedText && data.pinned) {
                pinnedText.innerHTML = `<strong>${escapeHtml(data.pinned.nickname)}:</strong> ${escapeHtml(data.pinned.message)}`;
                pinnedBanner.style.display = 'flex';
            } else if (pinnedBanner) {
                pinnedBanner.style.display = 'none';
            }

            if (messages.length === 0) {
                container.innerHTML = '<div class="forum-empty">Chưa có tin nhắn.</div>';
                return;
            }

            container.innerHTML = '';
            allMessages = messages;
            oldestMessageId = messages[0].id;
            newestMessageId = messages[messages.length - 1].id;
            
            displayMessages(messages, false);
            scrollToBottom();
            
            if (messages.length < 50) {
                hasMoreOlder = false;
            }
        } catch (e) { console.error(e); }
    }

    async function loadOlderMessages() {
        if (isLoadingOlder || !hasMoreOlder || oldestMessageId === null || !container) return;
        isLoadingOlder = true;

        const loader = document.createElement('div');
        loader.className = 'forum-loading-older';
        loader.style.textAlign = 'center';
        loader.style.padding = '8px';
        loader.style.fontSize = '12px';
        loader.style.color = '#888';
        loader.innerText = 'Đang tải tin nhắn cũ hơn...';
        container.insertBefore(loader, container.firstChild);

        try {
            const response = await fetch('<?= $this->url("student/dashboard", ["action" => "chat"]) ?>?before_id=' + oldestMessageId);
            if (!response.ok) {
                loader.remove();
                isLoadingOlder = false;
                return;
            }
            const data = await response.json();
            const messages = data.messages || [];
            
            loader.remove();

            if (messages.length === 0) {
                hasMoreOlder = false;
                isLoadingOlder = false;
                return;
            }

            const prevScrollHeight = container.scrollHeight;
            const prevScrollTop = container.scrollTop;

            allMessages = messages.concat(allMessages);
            oldestMessageId = messages[0].id;

            displayMessages(messages, false, true);

            container.scrollTop = container.scrollHeight - prevScrollHeight + prevScrollTop;

            if (messages.length < 50) {
                hasMoreOlder = false;
            }
        } catch (e) { console.error(e); }
        isLoadingOlder = false;
    }

    async function pollNewMessages() {
        if (!container) return;
        try {
            const response = await fetch('<?= $this->url("student/dashboard", ["action" => "chat"]) ?>');
            if (!response.ok) return;
            const data = await response.json();
            const messages = data.messages || [];

            const pinnedBanner = document.getElementById('forum-pinned-banner');
            const pinnedText = document.getElementById('forum-pinned-text');
            if (pinnedBanner && pinnedText && data.pinned) {
                pinnedText.innerHTML = `<strong>${escapeHtml(data.pinned.nickname)}:</strong> ${escapeHtml(data.pinned.message)}`;
                pinnedBanner.style.display = 'flex';
            } else if (pinnedBanner) {
                pinnedBanner.style.display = 'none';
            }

            if (messages.length === 0) return;

            // Sync reactions for existing messages in DOM
            messages.forEach(msg => {
                const row = container.querySelector(`.forum-msg-row[data-msg-id="${msg.id}"]`);
                if (row) {
                    let msgReactions = {};
                    if (msg.reactions) {
                        try { msgReactions = JSON.parse(msg.reactions); } catch (e) { msgReactions = {}; }
                    }
                    const wrapper = row.querySelector('.forum-msg-reactions-wrapper');
                    if (wrapper) {
                        wrapper.innerHTML = renderReactionsHtml(msg.id, msgReactions);
                    }
                }
            });

            const newMsgs = messages.filter(msg => newestMessageId === null || msg.id > newestMessageId);
            
            if (newMsgs.length > 0) {
                const emptyMsg = container.querySelector('.forum-empty');
                if (emptyMsg) emptyMsg.remove();

                const shouldScroll = isScrolledToBottom();
                
                allMessages = allMessages.concat(newMsgs);
                newestMessageId = newMsgs[newMsgs.length - 1].id;
                if (oldestMessageId === null) {
                    oldestMessageId = newMsgs[0].id;
                }

                displayMessages(newMsgs, true);

                if (shouldScroll) {
                    scrollToBottom();
                }
            }
            
            // Check for deleted messages within the latest 50 messages
            const incomingIds = messages.map(m => m.id);
            const localLatestIds = allMessages.slice(-50).map(m => m.id);
            const deletedIds = localLatestIds.filter(id => !incomingIds.includes(id));
            if (deletedIds.length > 0) {
                deletedIds.forEach(id => {
                    allMessages = allMessages.filter(m => m.id !== id);
                    const row = container.querySelector(`.forum-msg-row[data-msg-id="${id}"]`);
                    if (row) row.remove();
                });
                if (allMessages.length === 0) {
                    oldestMessageId = null;
                    newestMessageId = null;
                } else {
                    oldestMessageId = allMessages[0].id;
                    newestMessageId = allMessages[allMessages.length - 1].id;
                }
            }
        } catch (e) { console.error(e); }
    }

    if (container) {
        container.addEventListener('scroll', () => {
            if (container.scrollTop === 0) {
                loadOlderMessages();
            }
        });
    }

    if (!isGuest) {
        window.sendCatalogMessage = async function() {
            const input = document.getElementById('catalog-chat-input');
            if (!input || !input.value.trim()) return;
            const msg = input.value; input.value = '';
            
            try {
                const response = await fetch('<?= $this->url("student/dashboard", ["action" => "chat"]) ?>', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'message=' + encodeURIComponent(msg)
                });
                
                const data = await response.json();
                if (!response.ok) {
                    alert(data.error || 'Có lỗi xảy ra khi gửi tin nhắn.');
                    input.value = msg; // Restore message so user can edit
                    return;
                }
                pollNewMessages();
            } catch (e) {
                console.error(e);
                alert('Không thể kết nối đến máy chủ.');
                input.value = msg;
            }
        };

        window.deleteCatalogMessage = async function(id) {
            if (!confirm('Xóa tin nhắn này?')) return;
            await fetch('<?= $this->url("student/dashboard", ["action" => "chat"]) ?>', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `action=delete&id=${id}`
            });
            pollNewMessages();
        };
    }

    const periodSelect = document.getElementById('leaderboard-period-select');
    if (periodSelect) {
        periodSelect.addEventListener('change', function() {
            const url = new URL(window.location.href);
            url.searchParams.set('leaderboard_period', this.value);
            window.location.href = url.toString();
        });
    }

    loadInitialMessages();
    catalogChatInterval = setInterval(pollNewMessages, 5000);
});
</script>
