<script>
document.addEventListener('DOMContentLoaded', () => {
    const annForm = document.getElementById('announcement-form');
    const annStartDate = document.getElementById('ann_start_date');
    const annEndDate = document.getElementById('ann_end_date');

    if (annForm && annStartDate && annEndDate) {
        const localDate = new Date();
        const year = localDate.getFullYear();
        const month = String(localDate.getMonth() + 1).padStart(2, '0');
        const day = String(localDate.getDate()).padStart(2, '0');
        const todayStr = `${year}-${month}-${day}`;

        // Set initial min date for end_date to today
        annEndDate.min = todayStr;

        annStartDate.addEventListener('change', function() {
            const minVal = (this.value && this.value > todayStr) ? this.value : todayStr;
            annEndDate.min = minVal;
            if (annEndDate.value && annEndDate.value < minVal) {
                annEndDate.value = '';
            }
        });

        annForm.addEventListener('submit', function(e) {
            if (annEndDate.value) {
                if (annEndDate.value < todayStr) {
                    e.preventDefault();
                    alert('Ngày kết thúc (Đến ngày) không được nhỏ hơn ngày hiện tại.');
                    return;
                }
                if (annStartDate.value && annEndDate.value < annStartDate.value) {
                    e.preventDefault();
                    alert('Ngày kết thúc (Đến ngày) không được nhỏ hơn ngày bắt đầu (Từ ngày).');
                    return;
                }
            }
        });
    }
});
</script>
