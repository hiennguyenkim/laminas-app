                            <td style="padding: 12px 16px; font-size: 12.5px; font-weight: 500;"><?= $dateStr ?></td>
                            <td class="text-muted" style="padding: 12px 16px; font-size: 12px;"><?= date('d/m/Y H:i', strtotime($ann['created_at'])) ?></td>
                            <td style="padding: 12px 16px;"><?= $statusBadge ?></td>
                            <td style="padding: 12px 16px; text-align: center;">
                                <div style="display: flex; gap: 6px; justify-content: center;">
                                    <a href="<?= $this->url('announcements/view', ['id' => $ann['id']]) ?>" class="btn btn-outline btn-xs" title="Xem chi tiết" style="padding: 4px 8px; font-size: 12px;"><i class="bi bi-eye"></i></a>
                                    <a href="<?= $this->url('library/announcements/edit', ['id' => $ann['id']]) ?>" class="btn btn-outline btn-xs" style="color: var(--accent-purple); border-color: var(--accent-purple); padding: 4px 8px; font-size: 12px;" title="Sửa"><i class="bi bi-pencil"></i></a>
                                    <a href="<?= $this->url('library/announcements/toggle', ['id' => $ann['id']]) ?>" class="btn btn-outline btn-xs" style="padding: 4px 8px; font-size: 12px;" onclick="return confirm('Thay đổi trạng thái hiển thị?')" title="Ẩn/Hiện"><i class="bi bi-eye-slash"></i></a>
                                    <a href="<?= $this->url('library/announcements/delete', ['id' => $ann['id']]) ?>" class="btn btn-xs text-danger" style="padding: 4px 8px; font-size: 12px;" onclick="return confirm('Xóa bản tin này?')" title="Xóa"><i class="bi bi-trash3"></i></a>
                                </div>
                            </td>
                        </tr>
                        <?php endforeach; ?>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <?php if ($totalPages > 1): ?>
        <div class="book-import-pagination-row" style="margin-top:20px; width: 100%;">
            <div class="book-import-pagination-info">
                Hiển thị trang <strong class="book-import-pagination-bold"><?= $page ?></strong> / <?= $totalPages ?>
                &nbsp;•&nbsp; Tổng <strong class="book-import-pagination-bold"><?= $totalCount ?></strong> bản tin
            </div>
            <div class="book-import-pagination-btns">
                <?php if ($page > 1): ?>
                    <a href="<?= $buildPageUrl(1) ?>" class="btn btn-outline btn-sm book-import-pagination-btn" title="Trang đầu"><i class="bi bi-chevron-double-left"></i></a>
                    <a href="<?= $buildPageUrl($page - 1) ?>" class="btn btn-outline btn-sm book-import-pagination-btn"><i class="bi bi-chevron-left"></i> Trước</a>
                <?php endif; ?>

                <?php
                $startPage = max(1, $page - 2);
                $endPage   = min($totalPages, $page + 2);
                for ($p = $startPage; $p <= $endPage; $p++):
                ?>
                    <a href="<?= $buildPageUrl($p) ?>"
                       class="btn btn-sm book-import-pagination-btn <?= $p === $page ? 'btn-primary' : 'btn-outline' ?>"
                       style="min-width:32px;text-align:center"><?= $p ?></a>
                <?php endfor; ?>

                <?php if ($page < $totalPages): ?>
                    <a href="<?= $buildPageUrl($page + 1) ?>" class="btn btn-outline btn-sm book-import-pagination-btn">Sau <i class="bi bi-chevron-right"></i></a>
                    <a href="<?= $buildPageUrl($totalPages) ?>" class="btn btn-outline btn-sm book-import-pagination-btn" title="Trang cuối"><i class="bi bi-chevron-double-right"></i></a>
                <?php endif; ?>
            </div>
        </div>
        <?php endif; ?>
        <?php endif; ?>
    </div>
</div>

<style>
