];

$buildPageUrl = function(int $p) use ($queryBase): string {
    $q = $queryBase;
    $q['page'] = $p;
    $q = array_filter($q, fn($v, $k) => $k === 'page' || $v !== '', ARRAY_FILTER_USE_BOTH);
    return $this->url('library/announcements', [], ['query' => $q]);
};

$buildSortUrl = function($field) use ($filters) {
    $q = [
        'search'    => $filters['search'],
        'type'      => $filters['type'],
        'status'    => $filters['status'],
        'sort'      => $field,
        'direction' => (($filters['sort'] ?? '') === $field && strtoupper($filters['direction'] ?? 'ASC') === 'ASC') ? 'DESC' : 'ASC',
        'page'      => 1,
    ];
    return $this->url('library/announcements', [], ['query' => array_filter($q, fn($v) => $v !== '')]);
};

$getSortIcon = function($field) use ($currentSort, $currentDir) {
    if ($currentSort !== $field) return '<i class="bi bi-arrow-down-up ms-1" style="opacity:0.3; font-size:10px;"></i>';
    return $currentDir === 'ASC' 
        ? '<i class="bi bi-sort-up ms-1 text-primary"></i>' 
        : '<i class="bi bi-sort-down ms-1 text-primary"></i>';
};

