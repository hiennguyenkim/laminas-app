<?php
$this->headTitle($isAdmin ? 'Quản lý thành viên' : 'Thành viên');
$this->layout('layout/library-layout');

$pagination = $pagination ?? [];
$page       = (int) ($pagination['page'] ?? 1);
$perPage    = (int) ($pagination['perPage'] ?? 8);
$totalItems = (int) ($pagination['totalItems'] ?? 0);
$totalPages = (int) ($pagination['totalPages'] ?? 1);

$queryBase = [
    'search' => (string) ($filters['search'] ?? ''),
    'role'   => (string) ($filters['role'] ?? ''),
];

$buildPageUrl = function(int $p) use ($queryBase): string {
    $q = $queryBase; $q['page'] = $p;
    $q = array_filter($q, fn($v, $k) => $k === 'page' || $v !== '', ARRAY_FILTER_USE_BOTH);
    return $this->url('library/user', [], ['query' => $q]);
};

$avatarColors = ['#7c6aff','#22c55e','#f97316','#ec4899','#3b82f6','#14b8a6','#ef4444','#fbbf24'];
$initials = function(string $name): string {
    $words = explode(' ', trim($name));
    if (count($words) >= 2) return strtoupper(substr($words[0], 0, 1).substr(end($words), 0, 1));
    return strtoupper(substr($name, 0, 2));
};
?>

<!-- PAGE HEADER -->
<div class="page-header">
    <div>
        <div class="page-title">Quản lý thành viên</div>
        <div class="page-subtitle"><?= number_format((int)($summary['total'] ?? 0)) ?> thành viên đã đăng ký</div>
