<?php
$this->headTitle('Quản lý thành viên');
$this->layout('layout/library-layout');

$pagination = is_array($pagination ?? null) ? $pagination : [];
$page       = (int) ($pagination['page'] ?? 1);
$perPage    = (int) ($pagination['perPage'] ?? 20);
$perPageRaw = $pagination['perPage'] ?? '20';
$totalItems = (int) ($pagination['totalItems'] ?? 0);
$totalPages = (int) ($pagination['totalPages'] ?? 1);

$currentSort = $filters['sort'] ?? 'id';
$currentDir  = strtoupper($filters['direction'] ?? 'ASC');

$buildPageUrl = function($p) use ($filters, $perPageRaw) {
    return $this->url('library/user', ['action' => 'index'], [
        'query' => array_merge($filters, ['page' => $p, 'perPage' => $perPageRaw])
    ]);
};

$buildSortUrl = function($field) use ($filters, $perPageRaw, $currentSort, $currentDir) {
    $dir = ($currentSort === $field && $currentDir === 'ASC') ? 'DESC' : 'ASC';
    return $this->url('library/user', ['action' => 'index'], [
        'query' => array_merge($filters, ['sort' => $field, 'direction' => $dir, 'page' => 1, 'perPage' => $perPageRaw])
    ]);
};

$getSortIcon = function($field) use ($currentSort, $currentDir) {
    if ($currentSort !== $field) return '<i class="bi bi-arrow-down-up ms-1" style="opacity:0.3; font-size:10px;"></i>';
    return $currentDir === 'ASC' 
        ? '<i class="bi bi-sort-up ms-1 text-primary"></i>' 
        : '<i class="bi bi-sort-down ms-1 text-primary"></i>';
};

$activeRole = (string)($filters['role'] ?? '');
$filterStatus = (string)($filters['status'] ?? '');

$buildTabUrl = function(string $roleVal) use ($filters, $perPageRaw) {
    return $this->url('library/user', ['action' => 'index'], [
        'query' => array_merge($filters, ['role' => $roleVal, 'page' => 1, 'perPage' => $perPageRaw])
    ]);
};

$avatarColors = ['#7c6aff','#22c55e','#f97316','#ec4899','#3b82f6','#14b8a6','#ef4444','#fbbf24'];
$initials = function(string $name): string {
    $words = explode(' ', trim($name));
    if (count($words) >= 2) return strtoupper(substr($words[0], 0, 1).substr(end($words), 0, 1));
    return strtoupper(substr($name, 0, 2));
};
