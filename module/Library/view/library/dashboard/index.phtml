// Donut Chart for Monthly Categories
(function() {
    const ctx = document.getElementById('categoryMonthlyChart');
    if (!ctx) return;
    const filterSelect = document.getElementById('categoryMonthlyFilter');
    const yearSelect = document.getElementById('categoryMonthlyYearFilter');
    const subtitle = document.getElementById('categoryMonthlySubtitle');
    const noDataMessage = document.getElementById('noDataMessage');
    const legendContainer = document.getElementById('categoryMonthlyLegend');
    const cardBody = ctx.closest('.card-body');
    const categoryStatsUrl = '<?= $this->url($routePrefix . '/dashboard', ['action' => 'category-stats']) ?>';
    
    // Store current year data (default to PHP rendered data)
    let currentCategoryYearData = <?= $categoryMonthlyStatsJson ?>;
    
    // Consistent color mapping for categories
    const categoryColors = ['#7c6aff','#22c55e','#f97316','#ec4899','#3b82f6','#14b8a6','#fbbf24','#ef4444','#6366f1','#10b981','#f59e0b','#f43f5e','#06b6d4','#8b5cf6','#a855f7','#6b7280'];
    const colorMap = {};
    let colorIdx = 0;
    
    function getColorForCategory(catName) {
        if (!colorMap[catName]) {
            colorMap[catName] = categoryColors[colorIdx % categoryColors.length];
            colorIdx++;
        }
        return colorMap[catName];
    }
    
    // Pre-populate color map from initial data
    for (const catName in currentCategoryYearData) {
        getColorForCategory(catName);
    }

    let chartInstance = null;

    function updateChart() {
        const selectedValue = filterSelect.value;
        const selectedYear = yearSelect ? yearSelect.value : new Date().getFullYear();
        const labels = [];
        const data = [];
        const backgroundColors = [];

        for (const catName in currentCategoryYearData) {
            const monthlyCounts = currentCategoryYearData[catName];
            let count = 0;

            if (selectedValue === 'year') {
                count = monthlyCounts.reduce((sum, val) => sum + val, 0);
            } else {
                const monthIndex = parseInt(selectedValue, 10) - 1;
                count = monthlyCounts[monthIndex] || 0;
            }

            if (count > 0) {
                labels.push(catName);
                data.push(count);
                backgroundColors.push(getColorForCategory(catName));
            }
        }

        // Update subtitle text dynamically
        if (subtitle) {
            if (selectedValue === 'year') {
                subtitle.textContent = 'Chi tiết số lượt mượn của từng thể loại cả năm ' + selectedYear;
            } else {
                subtitle.textContent = 'Chi tiết số lượt mượn của từng thể loại trong Tháng ' + selectedValue + ' năm ' + selectedYear;
            }
        }

        if (data.length === 0) {
            ctx.style.display = 'none';
            if (legendContainer) legendContainer.style.display = 'none';
            if (noDataMessage) noDataMessage.style.display = 'block';
            if (chartInstance) {
                chartInstance.destroy();
                chartInstance = null;
            }
        } else {
            ctx.style.display = 'block';
            if (legendContainer) legendContainer.style.display = 'flex';
            if (noDataMessage) noDataMessage.style.display = 'none';

            // Calculate total for percentage calculation
            const total = data.reduce((sum, val) => sum + val, 0) || 1;

            // Generate HTML legend
            if (legendContainer) {
                let legendHtml = '';
                for (let i = 0; i < labels.length; i++) {
                    const catName = labels[i];
                    const val = data[i];
                    const color = backgroundColors[i];
                    const pct = Math.round((val / total) * 100);

                    legendHtml += `
                        <div class="donut-legend-item">
                            <div class="donut-legend-label"><div class="donut-legend-dot" style="background:${color}"></div>${catName}</div>
                            <div class="donut-legend-bar"><div class="donut-legend-bar-fill" style="width:${pct}%;background:${color}"></div></div>
                            <div class="donut-legend-pct">${pct}%</div>
                        </div>
                    `;
                }
                legendContainer.innerHTML = legendHtml;
            }

            if (chartInstance) {
                chartInstance.data.labels = labels;
                chartInstance.data.datasets[0].data = data;
                chartInstance.data.datasets[0].backgroundColor = backgroundColors;
                chartInstance.update();
            } else {
                chartInstance = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: data,
                            backgroundColor: backgroundColors,
                            borderWidth: 0,
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '68%',
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                enabled: true
                            }
                        }
                    }
                });
            }
        }
    }

    function fetchCategoryNewYearData(year) {
        if (cardBody) {
            cardBody.style.opacity = '0.4';
            cardBody.style.transition = 'opacity 0.15s ease';
        }

        fetch(categoryStatsUrl + '?year=' + encodeURIComponent(year))
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                currentCategoryYearData = data || {};
                updateChart();
            })
            .catch(error => {
                console.error('Error loading category monthly stats:', error);
            })
            .finally(() => {
                if (cardBody) {
                    cardBody.style.opacity = '1';
                }
            });
    }

    updateChart();
    
    if (filterSelect) {
        filterSelect.addEventListener('change', updateChart);
    }
    if (yearSelect) {
        yearSelect.addEventListener('change', function() {
            fetchCategoryNewYearData(yearSelect.value);
        });
    }
})();

</script>
