<script>
<?php
$monthlyStats  = (!empty($monthlyStats) && isset($monthlyStats['borrow'], $monthlyStats['return']))
    ? $monthlyStats
    : ['borrow' => array_fill(0, 12, 0), 'return' => array_fill(0, 12, 0)];
$borrowData    = json_encode(array_values($monthlyStats['borrow']));
$returnData    = json_encode(array_values($monthlyStats['return']));

// Category chart
$catColors = ['#7c6aff','#22c55e','#f97316','#ec4899','#3b82f6','#14b8a6','#fbbf24','#ef4444'];
$categoryStats = $categoryStats ?? [];
$catLabels = json_encode(array_keys($categoryStats));
$catData   = json_encode(array_values($categoryStats));
$catColorsUsed = json_encode(array_slice($catColors, 0, count($categoryStats)));

// Category monthly stats JSON
$categoryMonthlyStatsJson = $isAdmin ? json_encode($categoryMonthlyStats ?? [], JSON_UNESCAPED_UNICODE) : '[]';
?>
// Line Chart
(function() {
    const ctx = document.getElementById('borrowChart');
    if (!ctx) return;

    const yearFilter = document.getElementById('borrowChartYearFilter');
    const quarterFilter = document.getElementById('borrowChartQuarterFilter');
    const subtitle = document.getElementById('borrowChartSubtitle');
    const chartArea = ctx.closest('.dashboard-chart-area');
    const statsUrl = '<?= $this->url($routePrefix . '/dashboard', ['action' => 'stats']) ?>';

    // Store current full 12-month data loaded from PHP
    let currentYearData = {
        borrow: <?= $borrowData ?>,
        return: <?= $returnData ?>
    };

    const allLabels = ['T1','T2','T3','T4','T5','T6','T7','T8','T9','T10','T11','T12'];

    const chartInstance = new Chart(ctx, {
        type: 'line',
        data: {
            labels: allLabels,
            datasets: [{
                label: 'Mượn', data: currentYearData.borrow,
                borderColor: '#7c6aff', backgroundColor: 'rgba(124,106,255,0.12)',
                fill: true, tension: 0.45, pointRadius: 3, borderWidth: 2.5
            },{
                label: 'Trả', data: currentYearData.return,
                borderColor: '#22c55e', backgroundColor: 'rgba(34,197,94,0.08)',
                fill: true, tension: 0.45, pointRadius: 3, borderWidth: 2.5
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { color: 'rgba(255,255,255,0.04)' }, ticks: { color: '#5a6282', font: { size: 11 } } },
                y: { grid: { color: 'rgba(255,255,255,0.04)' }, ticks: { color: '#5a6282', font: { size: 11 }, precision: 0 } }
            }
        }
    });

    function applyFilterAndRefresh() {
        const quarter = quarterFilter ? quarterFilter.value : 'all';
        const year = yearFilter ? yearFilter.value : new Date().getFullYear();

        let labels = [];
        let borrowSlice = [];
        let returnSlice = [];

        if (quarter === 'all') {
            labels = allLabels;
            borrowSlice = currentYearData.borrow;
            returnSlice = currentYearData.return;
            if (subtitle) {
                subtitle.textContent = 'Theo tháng trong năm ' + year;
            }
        } else if (quarter === '1') {
            labels = ['T1', 'T2', 'T3'];
            borrowSlice = currentYearData.borrow.slice(0, 3);
            returnSlice = currentYearData.return.slice(0, 3);
            if (subtitle) {
                subtitle.textContent = 'Quý 1 năm ' + year;
            }
        } else if (quarter === '2') {
            labels = ['T4', 'T5', 'T6'];
            borrowSlice = currentYearData.borrow.slice(3, 6);
            returnSlice = currentYearData.return.slice(3, 6);
            if (subtitle) {
                subtitle.textContent = 'Quý 2 năm ' + year;
            }
        } else if (quarter === '3') {
            labels = ['T7', 'T8', 'T9'];
            borrowSlice = currentYearData.borrow.slice(6, 9);
            returnSlice = currentYearData.return.slice(6, 9);
            if (subtitle) {
                subtitle.textContent = 'Quý 3 năm ' + year;
            }
        } else if (quarter === '4') {
            labels = ['T10', 'T11', 'T12'];
            borrowSlice = currentYearData.borrow.slice(9, 12);
            returnSlice = currentYearData.return.slice(9, 12);
            if (subtitle) {
                subtitle.textContent = 'Quý 4 năm ' + year;
            }
        }

        chartInstance.data.labels = labels;
        chartInstance.data.datasets[0].data = borrowSlice;
        chartInstance.data.datasets[1].data = returnSlice;
        chartInstance.update();
    }

    function fetchNewYearData(year) {
        if (chartArea) {
            chartArea.style.opacity = '0.4';
            chartArea.style.transition = 'opacity 0.15s ease';
        }

        fetch(statsUrl + '?year=' + encodeURIComponent(year))
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                if (data && data.borrow && data.return) {
                    currentYearData.borrow = data.borrow;
                    currentYearData.return = data.return;
                    applyFilterAndRefresh();
                }
            })
            .catch(error => {
                console.error('Error loading monthly stats:', error);
            })
            .finally(() => {
                if (chartArea) {
                    chartArea.style.opacity = '1';
                }
            });
    }

    if (yearFilter) {
        yearFilter.addEventListener('change', function() {
            fetchNewYearData(yearFilter.value);
        });
    }

    if (quarterFilter) {
        quarterFilter.addEventListener('change', applyFilterAndRefresh);
    }
})();


