// Initials for avatars
$getInitials = function(string $name): string {
    $words = explode(' ', trim($name));
    if (count($words) >= 2) return strtoupper(mb_substr($words[0], 0, 1) . mb_substr(end($words), 0, 1));
    return strtoupper(mb_substr($name, 0, 2));
};

