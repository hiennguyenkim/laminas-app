<script>
document.addEventListener('DOMContentLoaded', function() {
    if (typeof Chart === 'undefined') {
        console.error('Chart.js library not loaded');
        return;
    }

    // 1. Line Chart
    const ctxLine = document.getElementById('borrowChart');
    if (ctxLine) {
        const quarterFilter = document.getElementById('borrowChartQuarterFilter');
        const subtitle = document.getElementById('borrowChartSubtitle');
        
        let currentYearData = {
            borrow: <?= json_encode(array_values($monthlyStats['borrow'])) ?>,
            return: <?= json_encode(array_values($monthlyStats['return'])) ?>
        };

        const allLabels = ['T1','T2','T3','T4','T5','T6','T7','T8','T9','T10','T11','T12'];
        const chartInstance = new Chart(ctxLine, {
            type: 'line',
            data: {
                labels: allLabels,
                datasets: [
                    {label:'Mượn', data:currentYearData.borrow, borderColor:'#7c6aff', backgroundColor:'rgba(124,106,255,0.12)', fill:true, tension:0.4, borderWidth:2.5, pointRadius:3},
                    {label:'Trả', data:currentYearData.return, borderColor:'#22c55e', backgroundColor:'transparent', fill:false, tension:0.4, borderWidth:2.5, pointRadius:3}
                ]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } },
                scales: { x: { grid: { color: 'rgba(255,255,255,0.04)' } }, y: { grid: { color: 'rgba(255,255,255,0.04)' }, beginAtZero: true } }
            }
        });

        const updateLegend = (b, r) => {
            const elB = document.getElementById('legendTotalBorrow');
            const elR = document.getElementById('legendTotalReturn');
            if (elB) elB.textContent = b.reduce((s,v)=>s+v,0).toLocaleString('vi-VN');
            if (elR) elR.textContent = r.reduce((s,v)=>s+v,0).toLocaleString('vi-VN');
        };

        const refresh = () => {
            const q = quarterFilter.value;
            let l = allLabels, b = currentYearData.borrow, r = currentYearData.return;
            if (q !== 'all') {
                const start = (parseInt(q)-1)*3;
                l = allLabels.slice(start, start+3);
                b = currentYearData.borrow.slice(start, start+3);
                r = currentYearData.return.slice(start, start+3);
                subtitle.textContent = 'Quý ' + q + ' năm ' + new Date().getFullYear();
            } else {
                subtitle.textContent = 'Theo tháng trong năm ' + new Date().getFullYear();
            }
            chartInstance.data.labels = l;
            chartInstance.data.datasets[0].data = b;
            chartInstance.data.datasets[1].data = r;
            chartInstance.update();
            updateLegend(b, r);
        };

        quarterFilter.addEventListener('change', refresh);
        refresh();
    }

    // 2. Inventory Donut
    const ctxInv = document.getElementById('inventoryChart');
    if (ctxInv) {
        new Chart(ctxInv, {
            type: 'doughnut',
            data: {
                labels: <?= json_encode(array_keys($inventoryStatus)) ?>,
                datasets: [{
                    data: <?= json_encode(array_values($inventoryStatus)) ?>,
                    backgroundColor: ['#22c55e', '#7c6aff', '#ef4444', '#f97316', '#64748b'],
                    borderWidth: 0, cutout: '70%'
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, cutout: '70%',
                plugins: { legend: { display: false }, tooltip: { enabled: true } }
            }
        });
    }

    // 3. Category Composition (Pie)
    const ctxComp = document.getElementById('categoryCompositionChart');
    if (ctxComp) {
        new Chart(ctxComp, {
            type: 'pie',
            data: {
                labels: <?= json_encode(array_keys($categoryStats)) ?>,
                datasets: [{
                    data: <?= json_encode(array_values($categoryStats)) ?>,
                    backgroundColor: ['#7c6aff', '#22c55e', '#f97316', '#ec4899', '#3b82f6', '#14b8a6', '#f59e0b', '#ef4444'],
                    borderWidth: 1, borderColor: 'rgba(255,255,255,0.1)'
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right', labels: { boxWidth: 10, font: { size: 10 }, color: '#a2a5b9' } } } }
        });
    }

    // 4. Currently Borrowed Categories (Bar)
    const ctxBorr = document.getElementById('borrowedCategoryChart');
    if (ctxBorr) {
        new Chart(ctxBorr, {
            type: 'bar',
            data: {
                labels: <?= json_encode(array_keys($borrowingCategoryStats)) ?>,
                datasets: [{
                    label: 'Số lượng đang mượn',
                    data: <?= json_encode(array_values($borrowingCategoryStats)) ?>,
                    backgroundColor: 'rgba(249, 115, 22, 0.6)',
                    borderColor: '#f97316',
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: 'rgba(255,255,255,0.04)' }, ticks: { color: '#a2a5b9', font: { size: 10 } } },
                    y: { grid: { display: false }, ticks: { color: '#e2e8f0', font: { size: 11, weight: '600' } } }
                }
            }
        });
    }
});
</script>
