<script>
(function () {
    'use strict';

    // ── Cấu hình ──────────────────────────────────────────
    const SEARCH_API      = '<?= $this->url('api/books-search') ?>';
    const USER_SEARCH_API = '<?= $this->url('api/users-search') ?>';
    const MIN_CHARS       = 1;          // Bắt đầu tìm từ 1 ký tự
    const DEBOUNCE_MS     = 280;        // Tránh spam request

    // ── DOM refs ──────────────────────────────────────────
    const searchInput    = document.getElementById('book-search-input');
    const hiddenBookId   = document.getElementById('book-id-hidden');
    const dropdown       = document.getElementById('book-dropdown');
    const clearBtn       = document.getElementById('clear-book-btn');
    const selectedCard   = document.getElementById('selected-book-card');
    const submitBtn      = document.getElementById('submit-btn');
    const borrowDateEl   = document.getElementById('borrow-date');
    const returnDateEl   = document.getElementById('return-date');

    const userSearchInput = document.getElementById('user-search-input');
    const realUserSelect  = document.getElementById('real-user-select');
    const userDropdown    = document.getElementById('user-dropdown');
    const clearUserBtn    = document.getElementById('clear-user-btn');
    const selectedUserCard = document.getElementById('selected-user-card');

    // ── State ─────────────────────────────────────────────
    let selectedBookId  = 0;
    let selectedUserId  = 0;
    let highlightIndex  = -1;
    let userHighlightIndex = -1;

    // ── Khởi tạo ngày hợp lệ ──────────────────────────────
    if (borrowDateEl && returnDateEl) {
        borrowDateEl.addEventListener('change', function () {
            if (returnDateEl.value < borrowDateEl.value) {
                returnDateEl.value = borrowDateEl.value;
            }
            returnDateEl.min = borrowDateEl.value;
            const borrow = new Date(borrowDateEl.value);
            const ret    = new Date(returnDateEl.value);
            const diff   = (ret - borrow) / 86400000;
            if (diff > 30) {
                const maxDate = new Date(borrow);
                maxDate.setDate(maxDate.getDate() + 30);
                returnDateEl.value = maxDate.toISOString().split('T')[0];
            }
        });
    }

    // ── Hàm debounce ──────────────────────────────────────
    function debounce(fn, ms) {
        let timer = null;
        return function (...args) {
            clearTimeout(timer);
            timer = setTimeout(() => fn.apply(this, args), ms);
        };
    }

    // ── Hàm escape HTML ───────────────────────────────────
    function esc(str) {
        const d = document.createElement('div');
        d.textContent = str;
        return d.innerHTML;
    }

    // ── Highlight từ khóa trong text ──────────────────────
    function highlight(text, query) {
        if (! query) return esc(text);
        const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const re = new RegExp('(' + escaped + ')', 'gi');
        return esc(text).replace(re, '<mark style="background:rgba(124,106,255,.25);color:inherit;border-radius:2px;padding:0 1px">$1</mark>');
    }

    /* ==========================================================================
       BOOK AUTOCOMPLETE
       ========================================================================== */
    function renderDropdown(books, query) {
        if (books.length === 0) {
            dropdown.innerHTML = '<div class="search-no-result"><i class="bi bi-inbox"></i> Không tìm thấy sách nào phù hợp.</div>';
        } else {
            dropdown.innerHTML = books.map((b, idx) => `
                <div class="book-option" data-idx="${idx}" data-book='${JSON.stringify(b).replace(/'/g, "&#39;")}'>
                    <div class="book-option-icon"><i class="bi bi-book"></i></div>
                    <div class="book-option-info">
                        <div class="book-option-title">${highlight(b.title, query)}</div>
                        <div class="book-option-meta">${esc(b.author)}${b.isbn ? ' · ISBN: ' + esc(b.isbn) : ''} · ${esc(b.category)}</div>
                    </div>
                    <div class="book-option-qty">Còn ${b.quantity}</div>
                </div>
            `).join('');

            dropdown.querySelectorAll('.book-option').forEach(el => {
                el.addEventListener('mousedown', function (e) {
                    e.preventDefault();
                    const book = JSON.parse(this.dataset.book);
                    selectBook(book);
                });
            });
        }
        dropdown.style.display = 'block';
        highlightIndex = -1;
    }

    function selectBook(book) {
        selectedBookId          = book.id;
        hiddenBookId.value      = book.id;
        searchInput.value       = book.title;
        if (clearBtn) clearBtn.style.display = 'inline-flex';
        dropdown.style.display  = 'none';

        document.getElementById('selected-title').textContent    = book.title;
        document.getElementById('selected-author').textContent   = book.author || '—';
        document.getElementById('selected-category').textContent = book.category || '—';
        document.getElementById('selected-qty').textContent      = 'Còn ' + book.quantity + ' cuốn';
        selectedCard.style.display = 'block';

        if (submitBtn) submitBtn.disabled = false;
        searchInput.style.outline = '';
        const err = document.getElementById('book-search-error');
        if (err) err.remove();
    }

    function clearSelection() {
        selectedBookId         = 0;
        hiddenBookId.value     = '';
        searchInput.value      = '';
        if (clearBtn) clearBtn.style.display = 'none';
        selectedCard.style.display = 'none';
        dropdown.style.display = 'none';
        searchInput.focus();
    }

    async function doSearch(query) {
        dropdown.innerHTML = '<div class="search-loading"><i class="bi bi-arrow-repeat"></i> Đang tìm...</div>';
        dropdown.style.display = 'block';

        try {
            const url  = `${SEARCH_API}?q=${encodeURIComponent(query)}&available_only=1&limit=20`;
            const resp = await fetch(url, { headers: { 'Accept': 'application/json' } });
            if (! resp.ok) throw new Error('HTTP ' + resp.status);
            const books = await resp.json();
            renderDropdown(books, query);
        } catch (err) {
            dropdown.innerHTML = '<div class="search-no-result"><i class="bi bi-exclamation-triangle"></i> Lỗi kết nối. Thử lại.</div>';
            console.error('Book search error:', err);
        }
    }

    const debouncedSearch = debounce(doSearch, DEBOUNCE_MS);

    if (searchInput) {
        searchInput.addEventListener('input', function () {
            const q = this.value.trim();
            if (selectedBookId > 0) {
                hiddenBookId.value         = '';
                selectedBookId             = 0;
                if (clearBtn) clearBtn.style.display = 'none';
                selectedCard.style.display = 'none';
            }
            debouncedSearch(q);
        });

        searchInput.addEventListener('focus', function () {
            if (selectedBookId === 0) {
                doSearch(this.value.trim());
            }
        });

        searchInput.addEventListener('click', function () {
            if (selectedBookId === 0) {
                doSearch(this.value.trim());
            }
        });

        searchInput.addEventListener('keydown', function (e) {
            const options = dropdown.querySelectorAll('.book-option');
            if (! options.length) return;

            if (e.key === 'ArrowDown') {
                e.preventDefault();
                highlightIndex = Math.min(highlightIndex + 1, options.length - 1);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                highlightIndex = Math.max(highlightIndex - 1, -1);
            } else if (e.key === 'Enter' && highlightIndex >= 0) {
                e.preventDefault();
                options[highlightIndex].dispatchEvent(new Event('mousedown'));
                return;
            } else if (e.key === 'Escape') {
                dropdown.style.display = 'none';
                return;
            } else {
                return;
            }

            options.forEach((o, i) => o.classList.toggle('highlighted', i === highlightIndex));
            if (highlightIndex >= 0) options[highlightIndex].scrollIntoView({ block: 'nearest' });
        });
    }

    if (clearBtn) clearBtn.addEventListener('click', clearSelection);

    /* ==========================================================================
       MEMBER AUTOCOMPLETE (CLIENT SIDE SEARCH)
       ========================================================================== */
    function renderUserDropdown(users, query) {
        if (users.length === 0) {
            userDropdown.innerHTML = '<div class="search-no-result"><i class="bi bi-inbox"></i> Không tìm thấy thành viên nào.</div>';
        } else {
            userDropdown.innerHTML = users.map((u, idx) => `
                <div class="book-option user-option" data-idx="${idx}" data-user='${JSON.stringify(u).replace(/'/g, "&#39;")}'>
                    <div class="book-option-icon" style="background:linear-gradient(135deg,#3b82f6,#60a5fa)"><i class="bi bi-person"></i></div>
                    <div class="book-option-info">
                        <div class="book-option-title">${highlight(u.label, query)}</div>
                        <div class="book-option-meta">Mã thành viên: #${u.id}</div>
                    </div>
                </div>
            `).join('');

            userDropdown.querySelectorAll('.user-option').forEach(el => {
                el.addEventListener('mousedown', function (e) {
                    e.preventDefault();
                    const user = JSON.parse(this.dataset.user);
                    selectUser(user);
                });
            });
        }
        userDropdown.style.display = 'block';
        userHighlightIndex = -1;
    }

    function selectUser(user) {
        selectedUserId = user.id;
        if (realUserSelect) {
            realUserSelect.value = user.id;
            realUserSelect.dispatchEvent(new Event('change'));
        }
        if (userSearchInput) userSearchInput.value = user.label;
        if (clearUserBtn) clearUserBtn.style.display = 'inline-flex';
        userDropdown.style.display = 'none';

        document.getElementById('selected-user-name').textContent = user.label;
        document.getElementById('selected-user-role').textContent = 'MSSV / Mã: #' + user.id;
        if (selectedUserCard) selectedUserCard.style.display = 'block';

        if (userSearchInput) userSearchInput.style.outline = '';
        const err = document.getElementById('user-select-error');
        if (err) err.remove();
    }

    function clearUserSelection() {
        selectedUserId = 0;
        if (realUserSelect) {
            realUserSelect.value = '';
            realUserSelect.dispatchEvent(new Event('change'));
        }
        if (userSearchInput) {
            userSearchInput.value = '';
            userSearchInput.focus();
        }
        if (clearUserBtn) clearUserBtn.style.display = 'none';
        if (selectedUserCard) selectedUserCard.style.display = 'none';
        userDropdown.style.display = 'none';
    }

    async function doUserSearch(query) {
        if (!userDropdown) return;

        userDropdown.innerHTML = '<div class="search-loading"><i class="bi bi-arrow-repeat"></i> Đang tìm...</div>';
        userDropdown.style.display = 'block';

        try {
            const url  = `${USER_SEARCH_API}?q=${encodeURIComponent(query)}&role=student&limit=15`;
            const resp = await fetch(url, { headers: { 'Accept': 'application/json' } });
            if (! resp.ok) throw new Error('HTTP ' + resp.status);
            const users = await resp.json();
            renderUserDropdown(users, query);
        } catch (err) {
            userDropdown.innerHTML = '<div class="search-no-result"><i class="bi bi-exclamation-triangle"></i> Lỗi kết nối. Thử lại.</div>';
            console.error('User search error:', err);
        }
    }

    const debouncedUserSearch = debounce(doUserSearch, DEBOUNCE_MS);

    if (userSearchInput) {
        userSearchInput.addEventListener('input', function () {
            const q = this.value.trim();
            if (selectedUserId > 0) {
                selectedUserId = 0;
                if (realUserSelect) realUserSelect.value = '';
                if (clearUserBtn) clearUserBtn.style.display = 'none';
                if (selectedUserCard) selectedUserCard.style.display = 'none';
            }
            debouncedUserSearch(q);
        });

        userSearchInput.addEventListener('focus', function () {
            if (selectedUserId === 0) {
                doUserSearch(this.value.trim());
            }
        });

        userSearchInput.addEventListener('click', function () {
            if (selectedUserId === 0) {
                doUserSearch(this.value.trim());
            }
        });

        userSearchInput.addEventListener('keydown', function (e) {
            const options = userDropdown.querySelectorAll('.user-option');
            if (! options.length) return;

            if (e.key === 'ArrowDown') {
                e.preventDefault();
                userHighlightIndex = Math.min(userHighlightIndex + 1, options.length - 1);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                userHighlightIndex = Math.max(userHighlightIndex - 1, -1);
            } else if (e.key === 'Enter' && userHighlightIndex >= 0) {
                e.preventDefault();
                options[userHighlightIndex].dispatchEvent(new Event('mousedown'));
                return;
            } else if (e.key === 'Escape') {
                userDropdown.style.display = 'none';
                return;
            } else {
                return;
            }

            options.forEach((o, i) => o.classList.toggle('highlighted', i === userHighlightIndex));
            if (userHighlightIndex >= 0) options[userHighlightIndex].scrollIntoView({ block: 'nearest' });
        });
    }

    if (clearUserBtn) clearUserBtn.addEventListener('click', clearUserSelection);

    // ── Ẩn dropdowns khi click ra ngoài ───────────────────
    document.addEventListener('click', function (e) {
        if (dropdown && ! e.target.closest('#book-search-wrap')) {
            dropdown.style.display = 'none';
        }
        if (userDropdown && ! e.target.closest('#user-search-wrap')) {
            userDropdown.style.display = 'none';
        }
    });

    // ── Prefill khi có ?book_id=... trong URL ─────────────
    (function prefillFromUrl() {
        const params = new URLSearchParams(window.location.search);
        const preId  = parseInt(params.get('book_id') || '0', 10);
        if (preId > 0) {
            fetch(`/api/books/${preId}`, { headers: { 'Accept': 'application/json' } })
                .then(r => r.json())
                .then(book => {
                    if (book && book.id && book.status === 'available') {
                        selectBook(book);
                    }
                })
                .catch(() => {});
        }
    })();

    // ── Validation trước khi submit ───────────────────────
    document.getElementById('borrow-form').addEventListener('submit', function (e) {
        let valid = true;

        if (! hiddenBookId.value || parseInt(hiddenBookId.value, 10) <= 0) {
            valid = false;
            if (searchInput) {
                searchInput.style.outline = '2px solid #ef4444';
                searchInput.focus();
            }
            let err = document.getElementById('book-search-error');
            if (! err) {
                err = document.createElement('div');
                err.id = 'book-search-error';
                err.style.cssText = 'color:#ef4444;font-size:12px;margin-top:5px';
                err.textContent   = 'Vui lòng chọn một cuốn sách từ danh sách.';
                const wrap = document.getElementById('book-search-wrap');
                if (wrap) wrap.after(err);
            }
        }

        if (realUserSelect && (! realUserSelect.value || parseInt(realUserSelect.value, 10) <= 0)) {
            valid = false;
            if (userSearchInput) {
                userSearchInput.style.outline = '2px solid #ef4444';
                if (valid) userSearchInput.focus();
            }
            let err = document.getElementById('user-select-error');
            if (! err) {
                err = document.createElement('div');
                err.id = 'user-select-error';
                err.style.cssText = 'color:#ef4444;font-size:12px;margin-top:5px';
                err.textContent   = 'Vui lòng chọn một thành viên từ danh sách.';
                const wrap = document.getElementById('user-search-wrap');
                if (wrap) wrap.after(err);
            }
        }

        if (returnDateEl && borrowDateEl && returnDateEl.value < borrowDateEl.value) {
            valid = false;
            returnDateEl.style.outline = '2px solid #ef4444';
            returnDateEl.focus();
        }

        if (!valid) {
            e.preventDefault();
        }
    });

    // ── Khởi tạo: ẩn submit nếu chưa chọn sách ──────────
    if (submitBtn && ! hiddenBookId.value) {
        // Không disable hoàn toàn vì Laminas validation sẽ bắt lỗi,
        // nhưng JS validation sẽ chặn trước khi submit.
    }

})();
</script>
