                    <label class="form-label" style="display: block; margin-bottom: 8px;">Nhận xét:</label>
                    <textarea name="comment" class="form-control" rows="4" placeholder="Chia sẻ cảm nghĩ của bạn về cuốn sách này..." required style="resize: none; border-radius: 8px; font-size: 13.5px;"></textarea>
                </div>
            </div>
            <div class="card-footer" style="display: flex; justify-content: flex-end; gap: 10px; padding: 16px 20px; border-top: 1px solid var(--border-color, #e2e8f0); background: rgba(0,0,0,0.05);">
                <button type="button" class="btn btn-outline" onclick="closeReviewModal()" style="font-size: 13px; height: 36px; padding: 0 16px; border-radius: 6px;">Hủy bỏ</button>
                <button type="submit" class="btn btn-primary" style="font-size: 13px; height: 36px; padding: 0 16px; border-radius: 6px;">Gửi đánh giá</button>
            </div>
        </form>
    </div>
</div>

<script>
function openReviewModal(bookId, bookTitle) {
    const modal = document.getElementById('reviewModal');
    const form = document.getElementById('reviewForm');
    const title = document.getElementById('modalBookTitle');
    const redirectInput = document.getElementById('modalRedirectInput');
    
    if (modal && form && title && redirectInput) {
        title.innerText = 'Đánh giá: ' + bookTitle;
        form.action = '<?= $this->url('student/book', ['action' => 'review']) ?>/' + bookId;
        redirectInput.value = window.location.href;
        modal.style.display = 'flex';
    }
}

function closeReviewModal() {
    const modal = document.getElementById('reviewModal');
    if (modal) {
        modal.style.display = 'none';
    }
}

window.addEventListener('click', function(event) {
    const modal = document.getElementById('reviewModal');
    if (event.target === modal) {
        closeReviewModal();
    }
});

function clearSearchInput(btn) {
    const input = btn.previousElementSibling;
    input.value = '';
    btn.style.display = 'none';
    input.focus();
    input.form.submit();
}

// Period to week numbers mapping
const periodToWeeks = {
    'year': { min: 1, max: 53 },
    'q1': { min: 1, max: 13 },
    'q2': { min: 14, max: 26 },
    'q3': { min: 27, max: 39 },
    'q4': { min: 40, max: 53 },
    'm1': { min: 1, max: 5 },
    'm2': { min: 5, max: 9 },
    'm3': { min: 9, max: 14 },
    'm4': { min: 14, max: 18 },
    'm5': { min: 18, max: 22 },
    'm6': { min: 22, max: 27 },
    'm7': { min: 27, max: 31 },
    'm8': { min: 31, max: 36 },
    'm9': { min: 36, max: 40 },
    'm10': { min: 40, max: 44 },
    'm11': { min: 44, max: 49 },
    'm12': { min: 49, max: 53 }
};

function updateWeekOptions(selectedPeriod, currentWeekVal) {
    const weekSelect = document.getElementById('weekSelect');
    if (!weekSelect) return;
    
    const range = periodToWeeks[selectedPeriod] || { min: 1, max: 53 };
    const options = weekSelect.querySelectorAll('option[data-week]');
    
    let isCurrentWeekValid = (currentWeekVal === 'all');
    
    options.forEach(opt => {
        const w = parseInt(opt.getAttribute('data-week'), 10);
        if (w >= range.min && w <= range.max) {
            opt.style.display = '';
            opt.disabled = false;
            opt.hidden = false;
            if (String(w) === String(currentWeekVal)) {
                isCurrentWeekValid = true;
            }
        } else {
            opt.style.display = 'none';
            opt.disabled = true;
            opt.hidden = true;
        }
    });
    
    if (!isCurrentWeekValid) {
        weekSelect.value = 'all';
    }
}

function onPeriodChange() {
    const periodSelect = document.getElementById('periodSelect');
    const weekSelect = document.getElementById('weekSelect');
    updateWeekOptions(periodSelect.value, weekSelect.value);
    periodSelect.form.submit();
}

document.addEventListener('DOMContentLoaded', () => {
    const periodSelect = document.getElementById('periodSelect');
    const weekSelect = document.getElementById('weekSelect');
    if (periodSelect && weekSelect) {
        updateWeekOptions(periodSelect.value, weekSelect.value);
    }
});
</script>
