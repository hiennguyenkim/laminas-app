    'search'    => (string) ($filters['search'] ?? ''),
    'status'    => (string) ($filters['status'] ?? ''),
    'year'      => (string) ($filters['year'] ?? ''),
    'period'    => (string) ($filters['period'] ?? ''),
    'week'      => (string) ($filters['week'] ?? ''),
    'sort'      => (string) ($filters['sort'] ?? ''),
    'direction' => (string) ($filters['direction'] ?? ''),
];

$buildPageUrl = function(int $p) use ($queryBase, $routePrefix): string {
    $q = $queryBase; $q['page'] = $p;
    $q = array_filter($q, fn($v, $k) => $k === 'page' || $v !== '', ARRAY_FILTER_USE_BOTH);
    return $this->url($routePrefix . '/transaction', [], ['query' => $q]);
};

$buildSortUrl = function(string $col) use ($queryBase, $routePrefix): string {
    $currentSort = $queryBase['sort'];
    $currentDir  = strtoupper($queryBase['direction']);
    if ($currentSort === $col) {
        $newDir = ($currentDir === 'ASC') ? 'DESC' : 'ASC';
    } else {
        $newDir = in_array($col, ['borrow_date', 'return_date']) ? 'DESC' : 'ASC';
    }
    $q = $queryBase;
    $q['sort'] = $col;
    $q['direction'] = $newDir;
    $q = array_filter($q, fn($v) => $v !== null && $v !== '');
    return $this->url($routePrefix . '/transaction', [], ['query' => $q]);
};

$renderSortIcon = function(string $col) use ($queryBase): string {
    $currentSort = $queryBase['sort'];
    $currentDir  = strtoupper($queryBase['direction']);
    if ($currentSort !== $col) {
        return '<i class="bi bi-arrow-down-up ms-1" style="font-size: 0.75rem; opacity: 0.4;"></i>';
    }
    if ($currentDir === 'ASC') {
        return '<i class="bi bi-sort-down ms-1" style="font-size: 0.85rem; color: var(--primary-color);"></i>';
    }
    return '<i class="bi bi-sort-up ms-1" style="font-size: 0.85rem; color: var(--primary-color);"></i>';
};
