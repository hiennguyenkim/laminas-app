<script>
function openApproveModal(actionUrl, userName, bookTitle, borrowDate, returnDate) {
    const modal = document.getElementById('approveModal');
    const form = document.getElementById('approveForm');
    const modalUser = document.getElementById('modalUser');
    const modalBook = document.getElementById('modalBook');
    const modalBorrowInput = document.getElementById('modalBorrowDate');
    const modalReturnInput = document.getElementById('modalReturnDate');

    form.action = actionUrl;
    modalUser.textContent = userName;
    modalBook.textContent = bookTitle;

    const today = new Date().toISOString().split('T')[0];
    modalBorrowInput.value = borrowDate && borrowDate !== '0000-00-00' ? borrowDate : today;
    
    if (returnDate && returnDate !== '0000-00-00') {
        modalReturnInput.value = returnDate;
    } else {
        const borrowVal = new Date(modalBorrowInput.value);
        borrowVal.setDate(borrowVal.getDate() + 14); // Default to 14 days
        modalReturnInput.value = borrowVal.toISOString().split('T')[0];
    }

    modal.style.display = 'flex';
    setTimeout(() => {
        modal.classList.add('show');
    }, 15);
}

function closeApproveModal() {
    const modal = document.getElementById('approveModal');
    modal.classList.remove('show');
    setTimeout(() => {
        modal.style.display = 'none';
    }, 220);
}
</script>
