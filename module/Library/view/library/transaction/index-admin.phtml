<script>
function openApproveModal(actionUrl, userName, bookTitle, borrowDate, returnDate) {
    const modal = document.getElementById('approveModal');
    const form = document.getElementById('approveForm');
    
    document.getElementById('modalUser').innerText = userName;
    document.getElementById('modalBook').innerText = bookTitle;
    document.getElementById('modalBorrowDate').value = borrowDate;
    document.getElementById('modalReturnDate').value = returnDate;
    
    form.action = actionUrl;
    modal.style.display = 'flex';
}

function closeApproveModal() {
    document.getElementById('approveModal').style.display = 'none';
}

function onPeriodChange() {
    const ps = document.getElementById('periodSelect');
    const ws = document.getElementById('weekSelect');
    if (ps && ws) {
        updateWeekOptions(ps.value, ws.value);
        ps.form.submit();
    }
}

function clearSearchInput(btn) {
    const input = btn.previousElementSibling;
    input.value = '';
    btn.style.display = 'none';
    input.focus();
    input.form.submit();
}

// Period to week numbers mapping
const periodToWeeks = {
    'year': { min: 1, max: 53 },
    'q1': { min: 1, max: 13 },
    'q2': { min: 14, max: 26 },
    'q3': { min: 27, max: 39 },
    'q4': { min: 40, max: 53 },
    'm1': { min: 1, max: 5 },
    'm2': { min: 5, max: 9 },
    'm3': { min: 9, max: 14 },
    'm4': { min: 14, max: 18 },
    'm5': { min: 18, max: 22 },
    'm6': { min: 22, max: 27 },
    'm7': { min: 27, max: 31 },
    'm8': { min: 31, max: 36 },
    'm9': { min: 36, max: 40 },
    'm10': { min: 40, max: 44 },
    'm11': { min: 44, max: 49 },
    'm12': { min: 49, max: 53 }
};

function updateWeekOptions(selectedPeriod, currentWeekVal) {
    const weekSelect = document.getElementById('weekSelect');
    if (!weekSelect) return;
    const range = periodToWeeks[selectedPeriod] || { min: 1, max: 53 };
    const options = weekSelect.querySelectorAll('option[data-week]');
    let isCurrentWeekValid = (currentWeekVal === 'all');
    options.forEach(opt => {
        const w = parseInt(opt.getAttribute('data-week'), 10);
        if (w >= range.min && w <= range.max) {
            opt.style.display = '';
            opt.disabled = false;
            if (String(w) === String(currentWeekVal)) isCurrentWeekValid = true;
        } else {
            opt.style.display = 'none';
            opt.disabled = true;
        }
    });
    if (!isCurrentWeekValid) weekSelect.value = 'all';
}

document.addEventListener('DOMContentLoaded', () => {
    // Confirm dialogs
    document.querySelectorAll('form[data-confirm]').forEach(form => {
        form.addEventListener('submit', function(e) {
            if (!confirm(this.getAttribute('data-confirm'))) e.preventDefault();
        });
    });

    const ps = document.getElementById('periodSelect');
    const ws = document.getElementById('weekSelect');
    if (ps && ws) updateWeekOptions(ps.value, ws.value);
});
</script>
