                    <input type="date" name="return_date" id="modalReturnDate" class="form-control" required>
                </div>
            </div>
            <div class="custom-modal-footer">
                <button type="button" class="btn btn-outline btn-sm" onclick="closeApproveModal()">Hủy bỏ</button>
                <button type="submit" class="btn btn-primary btn-sm">Xác nhận & Duyệt</button>
            </div>
        </form>
    </div>
</div>

<script>
function openApproveModal(actionUrl, userName, bookTitle, borrowDate, returnDate) {
    const modal = document.getElementById('approveModal');
    const form = document.getElementById('approveForm');
    const modalUser = document.getElementById('modalUser');
    const modalBook = document.getElementById('modalBook');
    const modalBorrowInput = document.getElementById('modalBorrowDate');
    const modalReturnInput = document.getElementById('modalReturnDate');

    form.action = actionUrl;
    modalUser.textContent = userName;
    modalBook.textContent = bookTitle;

    const today = new Date().toISOString().split('T')[0];
    modalBorrowInput.value = borrowDate && borrowDate !== '0000-00-00' ? borrowDate : today;
    
    if (returnDate && returnDate !== '0000-00-00') {
        modalReturnInput.value = returnDate;
    } else {
        const borrowVal = new Date(modalBorrowInput.value);
        borrowVal.setDate(borrowVal.getDate() + 14); // Default to 14 days
        modalReturnInput.value = borrowVal.toISOString().split('T')[0];
    }

    modal.classList.remove('d-none');
    setTimeout(() => {
        modal.classList.add('show');
    }, 15);
}

function closeApproveModal() {
    const modal = document.getElementById('approveModal');
    modal.classList.remove('show');
    setTimeout(() => {
        modal.classList.add('d-none');
    }, 220);
}

function onPeriodChange() {
    const periodSelect = document.getElementById('periodSelect');
    const weekSelect = document.getElementById('weekSelect');
    updateWeekOptions(periodSelect.value, weekSelect.value);
    periodSelect.form.submit();
}

function updateWeekOptions(selectedPeriod, currentWeekVal) {
    const weekSelect = document.getElementById('weekSelect');
    if (!weekSelect) return;
    const periodToWeeks = {
        'year': { min: 1, max: 53 }, 'q1': { min: 1, max: 13 }, 'q2': { min: 14, max: 26 }, 'q3': { min: 27, max: 39 }, 'q4': { min: 40, max: 53 },
        'm1': { min: 1, max: 5 }, 'm2': { min: 5, max: 9 }, 'm3': { min: 9, max: 14 }, 'm4': { min: 14, max: 18 }, 'm5': { min: 18, max: 22 }, 'm6': { min: 22, max: 27 },
        'm7': { min: 27, max: 31 }, 'm8': { min: 31, max: 36 }, 'm9': { min: 36, max: 40 }, 'm10': { min: 40, max: 44 }, 'm11': { min: 44, max: 49 }, 'm12': { min: 49, max: 53 }
    };
    const range = periodToWeeks[selectedPeriod] || { min: 1, max: 53 };
    const options = weekSelect.querySelectorAll('option[data-week]');
    let isCurrentWeekValid = (currentWeekVal === 'all');
    options.forEach(opt => {
        const w = parseInt(opt.getAttribute('data-week'), 10);
        if (w >= range.min && w <= range.max) { opt.style.display = ''; opt.disabled = false; if (String(w) === String(currentWeekVal)) isCurrentWeekValid = true; }
        else { opt.style.display = 'none'; opt.disabled = true; }
    });
    if (!isCurrentWeekValid) weekSelect.value = 'all';
}

document.addEventListener('DOMContentLoaded', () => {
    const periodSelect = document.getElementById('periodSelect');
    const weekSelect = document.getElementById('weekSelect');
    if (periodSelect && weekSelect) updateWeekOptions(periodSelect.value, weekSelect.value);
});

function clearSearchInput(btn) {
    const input = btn.previousElementSibling;
    input.value = '';
    btn.style.display = 'none';
    input.focus();
    const form = btn.closest('form');
    if (form) form.submit();
}
</script>
