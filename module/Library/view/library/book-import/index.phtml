<?php
$this->headTitle('Nhập sách Online & Thống kê chi tiêu');

$buildUrlWithFilter = function(array $newParams) use ($selectedYear, $search, $type, $page) {
    $params = [
        'year'   => $selectedYear,
        'search' => $search,
        'type'   => $type,
        'page'   => $page,
    ];
    
    foreach ($newParams as $key => $value) {
        if ($value === null || $value === '') {
            unset($params[$key]);
        } else {
            $params[$key] = $value;
        }
    }
    
    if (!isset($newParams['page']) && (isset($newParams['search']) || isset($newParams['type']) || isset($newParams['year']))) {
        $params['page'] = 1;
    }
    
    return $this->url('library/books-import', [], ['query' => array_filter($params, function($val) {
        return $val !== null && $val !== '';
    })]);
};
