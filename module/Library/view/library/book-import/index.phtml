$this->headTitle('Nhập sách & Thống kê chi tiêu');

$buildUrlWithFilter = function(array $newParams) use ($selectedYear, $search, $type, $period, $page, $sort, $direction) {
    $params = [
        'year'      => $selectedYear,
        'search'    => $search,
        'type'      => $type,
        'period'    => $period,
        'page'      => $page,
        'sort'      => $sort,
        'direction' => $direction,
    ];

    foreach ($newParams as $key => $value) {
        if ($value === null || $value === '') {
            unset($params[$key]);
        } else {
            $params[$key] = $value;
        }
    }

    if (!isset($newParams['page']) && (isset($newParams['search']) || isset($newParams['type']) || isset($newParams['year']) || isset($newParams['period']))) {    
        $params['page'] = 1;
    }

    return $this->url('library/books-import', [], ['query' => array_filter($params, function($val) {
        return $val !== null && $val !== '';
    })]);
};

$buildSortUrl = function(string $col) use ($buildUrlWithFilter, $sort, $direction) {
    if ($sort === $col) {
        $newDir = ($direction === 'asc') ? 'desc' : 'asc';
    } else {
        $newDir = in_array($col, ['price', 'quantity', 'total', 'id']) ? 'desc' : 'asc';
    }
    return $buildUrlWithFilter(['sort' => $col, 'direction' => $newDir]);
};

$renderSortIcon = function(string $col) use ($sort, $direction) {
    if ($sort !== $col) {
        return '<i class="bi bi-arrow-down-up ms-1" style="font-size: 0.75rem; opacity: 0.4;"></i>';
    }
    if ($direction === 'asc') {
        return '<i class="bi bi-sort-down ms-1" style="font-size: 0.85rem; color: var(--accent-purple);"></i>';
    }
    return '<i class="bi bi-sort-up ms-1" style="font-size: 0.85rem; color: var(--accent-purple);"></i>';
};
