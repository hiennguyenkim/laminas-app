<script>
function switchTab(tab) {
    const directBtn = document.getElementById('tab-btn-direct');
    const excelBtn = document.getElementById('tab-btn-excel');
    const directContent = document.getElementById('tab-content-direct');
    const excelContent = document.getElementById('tab-content-excel');

    if (tab === 'direct') {
        directBtn.classList.add('active');
        excelBtn.classList.remove('active');
        directContent.style.display = 'block';
        excelContent.style.display = 'none';
    } else {
        excelBtn.classList.add('active');
        directBtn.classList.remove('active');
        excelContent.style.display = 'block';
        directContent.style.display = 'none';
    }
}
</script>
