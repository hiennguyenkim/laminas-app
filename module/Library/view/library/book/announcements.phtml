    <h3 class="ann-empty-title">Không có bản tin nào</h3>
    <p class="ann-empty-desc">Không tìm thấy bản tin nào phù hợp với bộ lọc hiện tại.</p>
    <?php if ($typeFilter !== 'all' || $searchVal !== ''): ?>
    <a href="<?= $this->url('announcements') ?>" class="btn btn-outline btn-sm ann-empty-btn">Xóa bộ lọc</a>
    <?php endif; ?>
</div>
<?php else: ?>
<div class="ann-grid">
    <?php foreach ($announcements as $i => $ann):
        $cfg = $typeConfig[$ann['type']] ?? $typeConfig['general'];
        $isNew = (strtotime($ann['created_at']) > strtotime('-3 days'));

        // Date range display
        $dateStr = '';
        if ($ann['start_date'] && $ann['end_date']) {
            $dateStr = date('d/m', strtotime($ann['start_date'])) . ' – ' . date('d/m/Y', strtotime($ann['end_date']));
        } elseif ($ann['start_date']) {
            $dateStr = 'Từ ' . date('d/m/Y', strtotime($ann['start_date']));
        } elseif ($ann['end_date']) {
            $dateStr = 'Đến ' . date('d/m/Y', strtotime($ann['end_date']));
        }

        // Check if expired
        $isExpired = $ann['end_date'] && strtotime($ann['end_date']) < strtotime('today');
    ?>
    <div class="ann-card <?= $isExpired ? 'ann-card--expired' : '' ?>"
         style="--ann-border:<?= $cfg['border'] ?>;--ann-glow:<?= $cfg['glow'] ?>;--ann-light:<?= $cfg['light'] ?>;animation-delay:<?= $i * 0.07 ?>s">

        <!-- Top banner gradient -->
        <div class="ann-banner" style="background:<?= $cfg['gradient'] ?>">
            <span class="ann-emoji"><?= $cfg['emoji'] ?></span>
            <div class="ann-banner-right">
                <span class="ann-type-badge">
                    <i class="bi <?= $cfg['icon'] ?>"></i>
                    <?= $cfg['label'] ?>
                </span>
                <?php if ($isNew && !$isExpired): ?>
                    <span class="ann-new-dot">MỚI</span>
                <?php endif; ?>
            </div>
        </div>

        <!-- Content -->
        <div class="ann-body">
            <h3 class="ann-card-title"><?= htmlspecialchars($ann['title']) ?></h3>
            <div class="ann-content-text">
                <?= nl2br(htmlspecialchars($ann['content'])) ?>
            </div>

            <!-- Footer meta -->
            <div class="ann-meta">
                <?php if ($dateStr): ?>
                <span class="ann-meta-item ann-meta-item--accent">
                    <i class="bi bi-calendar-event"></i> <?= $dateStr ?>
                </span>
                <?php endif; ?>
                <span class="ann-meta-item">
                    <i class="bi bi-clock"></i>
                    <?= date('d/m/Y', strtotime($ann['created_at'])) ?>
                </span>
                <?php if ($isExpired): ?>
                <span class="ann-meta-item ann-expired-tag">
                    <i class="bi bi-archive"></i> Đã kết thúc
                </span>
                <?php endif; ?>
            </div>
        </div>

        <!-- Left accent bar -->
        <div class="ann-accent-bar" style="background:<?= $cfg['gradient'] ?>"></div>
    </div>
    <?php endforeach; ?>
</div>
<?php endif; ?>
