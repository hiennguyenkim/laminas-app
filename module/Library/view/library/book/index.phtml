<script>
document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.getElementById('categorySelectWrapper');
    if (!wrapper) return;
    
    const input = document.getElementById('categorySearchInput');
    const hidden = document.getElementById('book-category-hidden');
    const dropdown = document.getElementById('categoryDropdown');
    const options = dropdown.querySelectorAll('.dropdown-option');
    const noResults = document.getElementById('categoryNoResults');
    const form = document.getElementById('book-filter-form');
    
    let lastCategoryValue = hidden.value;

    input.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdown.style.display = 'block';
    });

    input.addEventListener('input', () => {
        const query = input.value.toLowerCase().trim();
        let count = 0;
        options.forEach(opt => {
            const text = opt.textContent.toLowerCase();
            if (text.includes(query)) {
                opt.style.display = 'block';
                count++;
            } else {
                opt.style.display = 'none';
            }
        });
        noResults.style.display = count === 0 ? 'block' : 'none';
        dropdown.style.display = 'block';
    });

    options.forEach(opt => {
        opt.addEventListener('click', () => {
            const val = opt.dataset.value;
            hidden.value = val;
            input.value = val === "" ? "" : opt.textContent;
            dropdown.style.display = 'none';
            if (val !== lastCategoryValue) { form.submit(); }
        });
    });

    document.addEventListener('click', (e) => {
        if (!wrapper.contains(e.target)) {
            dropdown.style.display = 'none';
            if (input.value !== "") {
                const catVal = hidden.value;
                const matchingOpt = Array.from(options).find(o => o.dataset.value === catVal);
                const matchingText = matchingOpt ? matchingOpt.textContent : "";
                if (input.value !== matchingText) {
                    input.value = catVal === "" ? "" : matchingText;
                }
            }
        }
    });

    // Handle sort selection with direction logic
    const sortSelect = document.querySelector('select[name="sort"]');
    const directionHidden = document.getElementById('sort-direction-hidden');
    if (sortSelect && directionHidden) {
        sortSelect.addEventListener('change', function() {
            const selectedOption = this.options[this.selectedIndex];
            const customDir = selectedOption.dataset.dir;
            if (customDir) {
                directionHidden.value = customDir;
            } else if (this.value === 'rating') {
                directionHidden.value = 'DESC'; // Default to DESC for stars
            } else {
                directionHidden.value = 'ASC';
            }
        });
    }

    // AI Search Toggle Logic
    const aiSearchHidden = document.getElementById('ai-search-hidden');
    const aiSearchToggleBtn = document.getElementById('btn-ai-search-toggle');
    const bookSearchInput = document.getElementById('book-search-input');
    
    if (aiSearchToggleBtn && aiSearchHidden && bookSearchInput) {
        const updateAiSearchUI = () => {
            const isAi = aiSearchHidden.value === '1';
            if (isAi) {
                aiSearchToggleBtn.style.borderColor = 'var(--accent-purple)';
                aiSearchToggleBtn.style.color = '#fff';
                aiSearchToggleBtn.style.backgroundColor = 'var(--accent-purple)';
                bookSearchInput.placeholder = 'Hỏi AI: Sách dạy làm giàu, tâm lý học...';
            } else {
                aiSearchToggleBtn.style.borderColor = 'var(--border-color)';
                aiSearchToggleBtn.style.color = 'var(--text-secondary)';
                aiSearchToggleBtn.style.backgroundColor = 'transparent';
                bookSearchInput.placeholder = 'Tìm tên sách, tác giả...';
            }
        };
        
        // Initialize
        updateAiSearchUI();
        
        aiSearchToggleBtn.addEventListener('click', () => {
            aiSearchHidden.value = aiSearchHidden.value === '1' ? '0' : '1';
            updateAiSearchUI();
            
            // If search input has value, automatically submit the form
            if (bookSearchInput.value.trim() !== '') {
                form.submit();
            }
        });
    }
});
</script>
