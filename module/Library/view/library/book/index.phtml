<script>
document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('book-list-container');
    if (!container) return;

    const filterForm = document.getElementById('book-filter-form');
    const searchInput = document.getElementById('book-search-input');
    const statusSelect = document.getElementById('book-status-select');

    let debounceTimer;
    function debounce(func, delay) {
        return function(...args) {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => func.apply(this, args), delay);
        };
    }

    async function loadBooks(url, updateHistory = true) {
        try {
            container.style.opacity = '0.5';
            
            const response = await fetch(url, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            if (!response.ok) throw new Error('Network error');
            const text = await response.text();
            
            const parser = new DOMParser();
            const doc = parser.parseFromString(text, 'text/html');
            const newContent = doc.getElementById('book-list-container');
            if (newContent) {
                container.innerHTML = newContent.innerHTML;
            }
            container.style.opacity = '1';

            if (updateHistory) {
                history.pushState({ url }, '', url);
            }

            bindEvents();
        } catch (e) {
            console.error('AJAX book load failed:', e);
            container.style.opacity = '1';
        }
    }

    function bindEvents() {
        const pageBtns = container.querySelectorAll('.page-btn');
        pageBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                const href = btn.getAttribute('href');
                if (href && href !== '#' && !btn.classList.contains('disabled')) {
                    e.preventDefault();
                    loadBooks(href);
                }
            });
        });
    }

    function reloadFromForm() {
        const params = new URLSearchParams();
        
        const activeTab = document.querySelector('.filter-tab.active');
        if (activeTab) {
            const catUrl = new URL(activeTab.href);
            const cat = catUrl.searchParams.get('category');
            if (cat) params.set('category', cat);
        }

        if (searchInput && searchInput.value.trim() !== '') {
            params.set('search', searchInput.value.trim());
        }
        if (statusSelect && statusSelect.value !== '') {
            params.set('status', statusSelect.value);
        }
        
        const newUrl = window.location.pathname + '?' + params.toString();
        loadBooks(newUrl);
    }

    if (searchInput) {
        searchInput.addEventListener('input', debounce(() => {
            reloadFromForm();
        }, 300));
    }

    if (statusSelect) {
        statusSelect.addEventListener('change', () => {
            reloadFromForm();
        });
    }

    if (filterForm) {
        filterForm.addEventListener('submit', (e) => {
            e.preventDefault();
            reloadFromForm();
        });
    }

    const filterTabs = document.querySelectorAll('.filter-tab');
    filterTabs.forEach(tab => {
        tab.addEventListener('click', (e) => {
            e.preventDefault();
            filterTabs.forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            
            const targetUrl = new URL(tab.href);
            if (searchInput && searchInput.value.trim() !== '') {
                targetUrl.searchParams.set('search', searchInput.value.trim());
            }
            if (statusSelect && statusSelect.value !== '') {
                targetUrl.searchParams.set('status', statusSelect.value);
            }
            
            loadBooks(targetUrl.toString());
        });
    });

    window.addEventListener('popstate', (e) => {
        if (e.state && e.state.url) {
            loadBooks(e.state.url, false);
            const urlObj = new URL(e.state.url);
            if (searchInput) searchInput.value = urlObj.searchParams.get('search') || '';
            if (statusSelect) statusSelect.value = urlObj.searchParams.get('status') || '';
            
            const cat = urlObj.searchParams.get('category') || '';
            filterTabs.forEach(t => {
                const tabUrl = new URL(t.href);
                const tabCat = tabUrl.searchParams.get('category') || '';
                if (tabCat === cat) {
                    t.classList.add('active');
                } else {
                    t.classList.remove('active');
                }
            });
        }
    });

    bindEvents();

    // Catalog Chat Room Functionality
    let catalogChatInterval = null;
    const currentUserId = <?= json_encode($authUser['id'] ?? 0) ?>;
    const currentUserRole = <?= json_encode($authUser['role'] ?? '') ?>;
    const basePath = <?= json_encode($this->basePath()) ?>;
    let lastMessagesJson = '';

    function escapeHtml(unsafe) {
        return (unsafe || '').replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }

    async function loadCatalogMessages() {
        try {
            const response = await fetch('<?= $this->url($routePrefix . "/dashboard", ["action" => "chat"]) ?>');
            if (!response.ok) return;
            const messages = await response.json();
            
            const messagesJson = JSON.stringify(messages);
            if (messagesJson === lastMessagesJson) {
                return;
            }
            lastMessagesJson = messagesJson;

            const container = document.getElementById('catalog-chat-body');
            if (!container) return;
            
            // Mark last message as seen
            if (messages.length > 0) {
                const lastMsg = messages[messages.length - 1];
                localStorage.setItem('catalog_chat_last_seen_id', lastMsg.id);
            }
            
            let html = '';
            messages.forEach(msg => {
                const colors = ['#7c6aff','#f97316','#22c55e','#3b82f6','#ec4899','#14b8a6'];
                let hash = 0;
                const usernameStr = msg.nickname || '';
                for (let i = 0; i < usernameStr.length; i++) {
                    hash = usernameStr.charCodeAt(i) + ((hash << 5) - hash);
                }
                const avatarColor = colors[Math.abs(hash) % colors.length];
                const initial = usernameStr.substring(0, 1).toUpperCase() || '?';
                const roleBadge = msg.role === 'admin' ? '<span class="badge badge-purple" style="font-size:9px;padding:2px 4px;margin-left:4px;vertical-align:middle">Thủ thư</span>' : '';
                const username = escapeHtml(msg.nickname) + roleBadge;
                const time = msg.created_at;
                const deleteBtn = (parseInt(msg.user_id) === currentUserId || currentUserRole === 'admin')
                    ? `<span onclick="deleteCatalogMessage(${msg.id})" style="cursor:pointer;color:#ef4444;font-size:11px;margin-left:6px" title="Xóa"><i class="bi bi-trash"></i></span>`
                    : '';
                const message = escapeHtml(msg.message);

                html += `<div style="display:flex;align-items:flex-start;gap:10px;padding:6px 0;
                             border-bottom:1px solid rgba(255,255,255,.04)">
                    <div style="width:32px;height:32px;border-radius:50%;
                                background:${avatarColor};flex-shrink:0;
                                display:flex;align-items:center;justify-content:center;
                                font-size:12px;font-weight:700;color:#fff">
                        ${initial}
                    </div>
                    <div style="flex:1;min-width:0">
                        <div style="display:flex;align-items:baseline;gap:8px;margin-bottom:3px">
                            <span style="font-size:13px;font-weight:600;color:#e2e8f0">${username}</span>
                            <span style="font-size:10px;color:#888">${time}</span>
                            ${deleteBtn}
                        </div>
                        <div style="font-size:13px;color:#cbd5e1;line-height:1.5;word-break:break-word">
                            ${message}
                        </div>
                    </div>
                </div>`;
            });
            
            if (html === '') {
                html = `
                    <div style="text-align:center;padding:40px;color:#888;font-size:12px;display:flex;flex-direction:column;align-items:center;gap:8px">
                        <i class="bi bi-chat-dots" style="font-size:28px;color:#888;opacity:0.6"></i>
                        <span>Chưa có tin nhắn nào. Hãy gửi tin nhắn đầu tiên để bắt đầu thảo luận!</span>
                    </div>
                `;
            }
            
            container.innerHTML = html;
            const body = document.getElementById('catalog-chat-body');
            if (body) {
                body.scrollTop = body.scrollHeight;
            }
        } catch (e) {
            console.error('Failed to load catalog chat messages:', e);
        }
    }

    window.sendCatalogMessage = async function() {
        const input = document.getElementById('catalog-chat-input');
        if (!input) return;
        const msg = input.value.trim();
        if (msg === '') return;
        input.value = '';
        
        try {
            const response = await fetch('<?= $this->url($routePrefix . "/dashboard", ["action" => "chat"]) ?>', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: 'message=' + encodeURIComponent(msg)
            });
            if (response.ok) {
                loadCatalogMessages();
            } else {
                console.error('Failed to send catalog chat message.');
            }
        } catch (e) {
            console.error(e);
        }
    };

    window.deleteCatalogMessage = async function(id) {
        if (!confirm('Bạn có chắc chắn muốn xóa tin nhắn này?')) return;
        try {
            const response = await fetch('<?= $this->url($routePrefix . "/dashboard", ["action" => "chat"]) ?>', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `action=delete&id=${id}`
            });
            if (response.ok) {
                loadCatalogMessages();
            } else {
                alert('Không thể xóa tin nhắn.');
            }
        } catch (e) {
            console.error(e);
        }
    };

    window.pinCatalogMessage = async function(id) {
        if (!confirm('Bạn có chắc chắn muốn ghim tin nhắn này?')) return;
        try {
            const response = await fetch('<?= $this->url($routePrefix . "/dashboard", ["action" => "chat"]) ?>', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `action=pin&id=${id}`
            });
            if (response.ok) {
                loadCatalogMessages();
            } else {
                alert('Không thể ghim tin nhắn.');
            }
        } catch (e) {
            console.error(e);
        }
    };

    window.unpinCatalogMessage = async function() {
        if (!confirm('Bạn có chắc chắn muốn gỡ ghim tin nhắn này?')) return;
        try {
            const response = await fetch('<?= $this->url($routePrefix . "/dashboard", ["action" => "chat"]) ?>', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `action=unpin`
            });
            if (response.ok) {
                loadCatalogMessages();
            } else {
                alert('Không thể gỡ ghim tin nhắn.');
            }
        } catch (e) {
            console.error(e);
        }
    };

    window.reactCatalogMessage = async function(id, emoji) {
        try {
            const response = await fetch('<?= $this->url($routePrefix . "/dashboard", ["action" => "chat"]) ?>', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `action=react&id=${id}&emoji=${encodeURIComponent(emoji)}`
            });
            if (response.ok) {
                loadCatalogMessages();
            } else {
                console.error('Failed to react.');
            }
        } catch (e) {
            console.error(e);
        }
    };

    loadCatalogMessages();
    catalogChatInterval = setInterval(loadCatalogMessages, 5000);
});
</script>
