<script>
document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('book-list-container');
    if (!container) return;

    const filterForm = document.getElementById('book-filter-form');
    const searchInput = document.getElementById('book-search-input');
    const statusSelect = document.getElementById('book-status-select');
    const categorySelect = document.getElementById('book-category-select');
    const perPageSelect = document.getElementById('book-perpage-select');
    
    // Custom searchable dropdown elements
    const categoryWrapper = document.getElementById('categorySelectWrapper');
    const categorySearchInput = document.getElementById('categorySearchInput');
    const categoryDropdown = document.getElementById('categoryDropdown');
    const categoryOptions = categoryDropdown ? categoryDropdown.querySelectorAll('.dropdown-option') : [];
    const categoryNoResults = document.getElementById('categoryNoResults');

    let debounceTimer;
    function debounce(func, delay) {
        return function(...args) {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => func.apply(this, args), delay);
        };
    }

    async function loadBooks(url, updateHistory = true) {
        try {
            container.style.opacity = '0.5';
            
            const response = await fetch(url, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            if (!response.ok) throw new Error('Network error');
            const text = await response.text();
            
            const parser = new DOMParser();
            const doc = parser.parseFromString(text, 'text/html');
            const newContent = doc.getElementById('book-list-container');
            if (newContent) {
                container.innerHTML = newContent.innerHTML;
            }
            container.style.opacity = '1';

            if (updateHistory) {
                history.pushState({ url }, '', url);
            }

            bindEvents();
        } catch (e) {
            console.error('AJAX book load failed:', e);
            container.style.opacity = '1';
        }
    }

    function bindEvents() {
        const pageBtns = container.querySelectorAll('.page-btn');
        pageBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                const href = btn.getAttribute('href');
                if (href && href !== '#' && !btn.classList.contains('disabled')) {
                    e.preventDefault();
                    loadBooks(href);
                }
            });
        });
    }

    function reloadFromForm() {
        const params = new URLSearchParams();
        
        if (categorySelect && categorySelect.value !== '') {
            params.set('category', categorySelect.value);
        }

        if (searchInput && searchInput.value.trim() !== '') {
            params.set('search', searchInput.value.trim());
        }
        if (statusSelect && statusSelect.value !== '') {
            params.set('status', statusSelect.value);
        }
        if (perPageSelect && perPageSelect.value !== '') {
            params.set('perPage', perPageSelect.value);
        }
        
        const newUrl = window.location.pathname + '?' + params.toString();
        loadBooks(newUrl);
    }

    if (searchInput) {
        searchInput.addEventListener('input', debounce(() => {
            reloadFromForm();
        }, 300));
    }

    if (statusSelect) {
        statusSelect.addEventListener('change', () => {
            reloadFromForm();
        });
    }

    if (perPageSelect) {
        perPageSelect.addEventListener('change', () => {
            reloadFromForm();
        });
    }

    let lastCategoryValue = categorySelect ? categorySelect.value : '';

    if (categorySearchInput && categorySelect && categoryWrapper) {
        const triggerReload = debounce(() => {
            if (categorySelect.value !== lastCategoryValue) {
                lastCategoryValue = categorySelect.value;
                reloadFromForm();
            }
        }, 300);

        function filterCategoryOptions() {
            const query = categorySearchInput.value.toLowerCase().trim();
            let matches = 0;

            categoryOptions.forEach(opt => {
                const text = opt.textContent.toLowerCase();
                if (text.includes(query) || opt.dataset.value === "") {
                    opt.classList.remove('hidden');
                    if (opt.dataset.value !== "") matches++;
                } else {
                    opt.classList.add('hidden');
                }
            });

            if (matches === 0 && query !== "") {
                if (categoryNoResults) categoryNoResults.style.display = 'block';
            } else {
                if (categoryNoResults) categoryNoResults.style.display = 'none';
            }
        }

        function selectCategory(value, text) {
            categorySelect.value = value;
            categorySearchInput.value = value === "" ? "" : text;
            
            categoryOptions.forEach(o => {
                if (o.dataset.value === value) {
                    o.classList.add('selected');
                } else {
                    o.classList.remove('selected');
                }
            });
            
            categoryWrapper.classList.remove('open');
            triggerReload();
        }

        function syncCategoryInputAndHidden() {
            const typed = categorySearchInput.value.trim().toLowerCase();
            let matchedOpt = null;

            categoryOptions.forEach(opt => {
                if (opt.dataset.value !== "" && opt.textContent.toLowerCase() === typed) {
                    matchedOpt = opt;
                }
            });

            if (matchedOpt) {
                selectCategory(matchedOpt.dataset.value, matchedOpt.textContent);
            } else {
                categorySelect.value = categorySearchInput.value.trim();
                triggerReload();
            }
        }

        // Toggle dropdown visibility on focus
        categorySearchInput.addEventListener('focus', () => {
            categoryWrapper.classList.add('open');
            filterCategoryOptions();
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
            if (!categoryWrapper.contains(e.target)) {
                categoryWrapper.classList.remove('open');
                syncCategoryInputAndHidden();
            }
        });

        // Search options as user types
        categorySearchInput.addEventListener('input', () => {
            categoryWrapper.classList.add('open');
            filterCategoryOptions();
            
            // Instantly update hidden input so live search triggers
            categorySelect.value = categorySearchInput.value.trim();
            triggerReload();
        });

        // Handle keys inside input
        categorySearchInput.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                categoryWrapper.classList.remove('open');
                categorySearchInput.blur();
            } else if (e.key === 'Enter') {
                e.preventDefault(); // Prevent submitting form directly
                
                // Select first visible option if open, else use typed text
                if (categoryWrapper.classList.contains('open')) {
                    const visibleOpts = Array.from(categoryOptions).filter(o => !o.classList.contains('hidden'));
                    if (visibleOpts.length > 0) {
                        selectCategory(visibleOpts[0].dataset.value, visibleOpts[0].textContent);
                    } else {
                        categorySelect.value = categorySearchInput.value.trim();
                        categoryWrapper.classList.remove('open');
                        triggerReload();
                    }
                } else {
                    categorySelect.value = categorySearchInput.value.trim();
                    triggerReload();
                }
                categorySearchInput.blur();
            }
        });

        // Option selection
        categoryOptions.forEach(opt => {
            opt.addEventListener('mousedown', (e) => {
                e.preventDefault(); // Prevent focus loss
                selectCategory(opt.dataset.value, opt.textContent);
            });
        });
    }

    if (filterForm) {
        filterForm.addEventListener('submit', (e) => {
            e.preventDefault();
            reloadFromForm();
        });
    }

    window.addEventListener('popstate', (e) => {
        if (e.state && e.state.url) {
            loadBooks(e.state.url, false);
            const urlObj = new URL(e.state.url);
            if (searchInput) searchInput.value = urlObj.searchParams.get('search') || '';
            if (statusSelect) statusSelect.value = urlObj.searchParams.get('status') || '';
            if (perPageSelect) perPageSelect.value = urlObj.searchParams.get('perPage') || '20';
            if (categorySelect) {
                const catVal = urlObj.searchParams.get('category') || '';
                categorySelect.value = catVal;
                
                // Find matching option text
                let matchingText = catVal;
                if (categoryOptions) {
                    categoryOptions.forEach(opt => {
                        if (opt.dataset.value === catVal) {
                            opt.classList.add('selected');
                            if (catVal !== "") {
                                matchingText = opt.textContent;
                            }
                        } else {
                            opt.classList.remove('selected');
                        }
                    });
                }
                
                if (categorySearchInput) {
                    categorySearchInput.value = catVal === "" ? "" : matchingText;
                }
                lastCategoryValue = catVal;
            }
        }
    });



    bindEvents();
});
</script>
