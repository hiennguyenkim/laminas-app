                        <?= $this->formHidden($form->get('csrf')) ?>
                        <?php $msgs = $form->get('csrf')->getMessages(); if ($msgs): ?>
                            <div class="form-validation-error-csrf" style="margin-top: 16px;"><i class="bi bi-shield-fill-exclamation"></i> <?= htmlspecialchars(implode(', ', $msgs)) ?></div>
                        <?php endif; ?>

                        <div class="form-actions-compact">
                            <button type="submit" class="btn-premium btn-submit-premium">
                                <i class="bi bi-check-circle-fill"></i> <?= $isEdit ? 'Lưu thay đổi' : 'Thêm sách mới' ?>
                            </button>
                            <a href="<?= $this->url('library/book') ?>" class="btn-premium btn-cancel-premium">
                                Hủy bỏ
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const fileInput = document.getElementById('coverImageInput');
    const urlInput = document.getElementById('coverImageUrlInput');
    const preview = document.getElementById('coverPreview');

    fileInput.addEventListener('change', function() {
        const file = this.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.style.background = `url(${e.target.result}) center/cover no-repeat`;
                preview.innerHTML = '';
            };
            reader.readAsDataURL(file);
        }
    });

    urlInput.addEventListener('input', function() {
        const val = this.value.trim();
        if (val) {
            preview.style.background = `url(${val}) center/cover no-repeat`;
            preview.innerHTML = '';
        } else if (!fileInput.files[0]) {
            preview.style.background = 'linear-gradient(135deg,#7c6aff,#5b4fcf)';
            preview.innerHTML = `<div class="placeholder-icon">
                                    <i class="bi bi-journal-album"></i>
                                    <span>Chưa có ảnh bìa</span>
                                 </div>`;
        }
    });
 
    const previewFileInput = document.getElementById('previewFileInput');
    const previewFileNameLabel = document.getElementById('previewFileNameLabel');
    if (previewFileInput && previewFileNameLabel) {
        previewFileInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                previewFileNameLabel.textContent = file.name + ' (' + (file.size / 1024 / 1024).toFixed(2) + ' MB)';
            }
        });
    }

    // Searchable Category Dropdown Logic
    const categoryWrapper = document.getElementById('categorySelectWrapper');
    const categorySearchInput = document.getElementById('categorySearchInput');
    const categoryHiddenInput = document.getElementById('categoryHiddenInput');
    const categoryDropdown = document.getElementById('categoryDropdown');
    const categoryOptions = categoryDropdown.querySelectorAll('.dropdown-option');
    const categoryNoResults = document.getElementById('categoryNoResults');

    // Initialize display with the hidden input value
    const initialVal = categoryHiddenInput.value.trim();
    if (initialVal) {
        categorySearchInput.value = initialVal;
        categoryOptions.forEach(opt => {
            if (opt.dataset.value === initialVal) {
                opt.classList.add('selected');
            }
        });
    }

    // Toggle dropdown visibility
    categorySearchInput.addEventListener('focus', () => {
        categoryWrapper.classList.add('open');
        filterCategoryOptions();
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
        if (!categoryWrapper.contains(e.target)) {
            categoryWrapper.classList.remove('open');
            validateAndSyncCategory();
        }
    });

    // Filter categories on type
    categorySearchInput.addEventListener('input', () => {
        categoryWrapper.classList.add('open');
        filterCategoryOptions();
    });

    // Handle keypresses on input
    categorySearchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
            e.preventDefault(); // Prevent accidental form submission
            
            // Find first visible option
            const visibleOpts = Array.from(categoryOptions).filter(o => !o.classList.contains('hidden'));
            if (visibleOpts.length > 0) {
                selectCategory(visibleOpts[0].dataset.value, visibleOpts[0].textContent);
            } else {
                validateAndSyncCategory();
            }
            categoryWrapper.classList.remove('open');
        }
    });

    // Select category on click
    categoryOptions.forEach(opt => {
        opt.addEventListener('mousedown', (e) => {
            // Use mousedown instead of click to fire before blur validation
            selectCategory(opt.dataset.value, opt.textContent);
        });
    });

    function filterCategoryOptions() {
        const query = categorySearchInput.value.toLowerCase().trim();
        let matches = 0;

        categoryOptions.forEach(opt => {
            const text = opt.textContent.toLowerCase();
            if (text.includes(query)) {
                opt.classList.remove('hidden');
                matches++;
            } else {
                opt.classList.add('hidden');
            }
        });

        if (matches === 0) {
            categoryNoResults.style.display = 'block';
        } else {
            categoryNoResults.style.display = 'none';
        }
    }

    function selectCategory(value, text) {
        categoryHiddenInput.value = value;
        categorySearchInput.value = text;
        categoryOptions.forEach(o => o.classList.remove('selected'));
        const activeOpt = Array.from(categoryOptions).find(o => o.dataset.value === value);
        if (activeOpt) activeOpt.classList.add('selected');
        categoryWrapper.classList.remove('open');
    }

    // Force validation: must match one of the suggestions!
    function validateAndSyncCategory() {
        const typed = categorySearchInput.value.trim().toLowerCase();
        let matchedOpt = null;

        // Try exact case-insensitive match
        categoryOptions.forEach(opt => {
            if (opt.textContent.toLowerCase() === typed) {
                matchedOpt = opt;
            }
        });

        if (matchedOpt) {
            selectCategory(matchedOpt.dataset.value, matchedOpt.textContent);
        } else {
            // Revert back to hidden input value if user typed invalid text
            const currentHiddenVal = categoryHiddenInput.value;
            const originalOpt = Array.from(categoryOptions).find(o => o.dataset.value === currentHiddenVal);
            if (originalOpt) {
                categorySearchInput.value = originalOpt.textContent;
            } else {
                categorySearchInput.value = '';
                categoryHiddenInput.value = '';
            }
        }
    }
});
</script>
