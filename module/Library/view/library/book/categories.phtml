<style>
.category-item-row:last-child {
    border-bottom: none !important;
}
.category-item-row:hover {
    background: rgba(255, 255, 255, 0.02);
}
.category-item-edit-trigger-btn:hover {
    color: var(--accent-purple) !important;
}
.category-item-delete-btn:hover {
    color: #ef4444 !important;
}
#category-search-input:focus {
    border-color: var(--accent-purple) !important;
    box-shadow: 0 0 0 3px rgba(124, 106, 255, 0.2);
}
#category-search-clear:hover {
    color: #ef4444 !important;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Search filter logic
    const searchInput = document.getElementById('category-search-input');
    const clearBtn = document.getElementById('category-search-clear');
    const rows = document.querySelectorAll('.category-item-row');
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            const query = searchInput.value.toLowerCase().trim();
            rows.forEach(row => {
                const nameEl = row.querySelector('.category-item-name');
                if (nameEl) {
                    const name = nameEl.textContent.toLowerCase();
                    if (name.includes(query)) {
                        row.style.setProperty('display', 'flex', 'important');
                    } else {
                        row.style.setProperty('display', 'none', 'important');
                    }
                }
            });

            if (searchInput.value.length > 0) {
                if (clearBtn) clearBtn.style.display = 'flex';
            } else {
                if (clearBtn) clearBtn.style.display = 'none';
            }
        });
    }

    if (clearBtn && searchInput) {
        clearBtn.addEventListener('click', function() {
            searchInput.value = '';
            clearBtn.style.display = 'none';
            searchInput.focus();
            searchInput.dispatchEvent(new Event('input'));
        });
    }

    // Inline editing functions
    window.enableEditMode = function(id) {
        const row = document.getElementById('cat-item-' + id);
        if (!row) return;
        const viewMode = row.querySelector('.cat-item-view-mode');
        const editMode = row.querySelector('.cat-item-edit-mode');
        if (viewMode && editMode) {
            viewMode.style.display = 'none';
            editMode.style.display = 'flex';
            const input = editMode.querySelector('input[name="category_name"]');
            if (input) {
                input.focus();
                input.select();
            }
        }
    };

    window.disableEditMode = function(id) {
        const row = document.getElementById('cat-item-' + id);
        if (!row) return;
        const viewMode = row.querySelector('.cat-item-view-mode');
        const editMode = row.querySelector('.cat-item-edit-mode');
        if (viewMode && editMode) {
            viewMode.style.display = 'flex';
            editMode.style.display = 'none';
        }
    };
});
</script>
