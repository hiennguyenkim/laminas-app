<?php
$this->headTitle('Hỗ trợ / Hỏi đáp');
$this->layout('layout/library-layout');
$authUser    = $this->currentUser();
$routePrefix = ($authUser['role'] ?? '') === 'admin' ? 'library' : 'student';

$statusMap = [
    'open' => ['Chưa phản hồi', 'badge-orange'],
    'in_progress' => ['Đã phản hồi', 'badge-green'],
    'closed' => ['Đã phản hồi', 'badge-green'],
    '' => ['Chưa phản hồi', 'badge-orange']
];

$page       = (int) ($page ?? 1);
$perPage    = (int) ($perPage ?? 10);
$totalCount = (int) ($totalCount ?? 0);
$totalPages = (int) ($totalPages ?? 1);

$queryBase = [
    'search' => (string) ($filters['search'] ?? ''),
    'status' => (string) ($filters['status'] ?? ''),
];

$buildPageUrl = function(int $p) use ($routePrefix, $queryBase): string {
    $q = $queryBase;
    $q['page'] = $p;
    $q = array_filter($q, fn($v, $k) => $k === 'page' || $v !== '', ARRAY_FILTER_USE_BOTH);
    return $this->url($routePrefix . '/ticket', [], ['query' => $q]);
};
?>

<div class="page-header">
    <div>
        <div class="page-title">Hỗ trợ / Hỏi đáp</div>
        <div class="page-subtitle">Quản lý các yêu cầu hỗ trợ và trao đổi giữa Thư viện và Độc giả.</div>
    </div>
    <?php if (!$isAdmin): ?>
    <a href="<?= $this->url($routePrefix . '/ticket', ['action' => 'create']) ?>" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>Gửi yêu cầu mới
    </a>
    <?php endif; ?>
</div>

<!-- FILTER TABS & SEARCH -->
<div class="user-filters-bar">
    <div class="filter-tabs user-filter-tabs">
        <a href="<?= $this->url($routePrefix . '/ticket', [], ['query' => array_filter(['search' => $filters['search'] ?? ''])]) ?>" class="filter-tab <?= !($filters['status'] ?? '') ? 'active' : '' ?>">
            Tất cả <span class="count"><?= (int)($allCount ?? 0) ?></span>
        </a>
        <a href="<?= $this->url($routePrefix . '/ticket', [], ['query' => array_filter(['status' => 'unanswered', 'search' => $filters['search'] ?? ''])]) ?>" class="filter-tab <?= ($filters['status'] ?? '') === 'unanswered' ? 'active' : '' ?>">
            Chưa phản hồi <span class="count"><?= (int)($unansweredCount ?? 0) ?></span>
        </a>
        <a href="<?= $this->url($routePrefix . '/ticket', [], ['query' => array_filter(['status' => 'answered', 'search' => $filters['search'] ?? ''])]) ?>" class="filter-tab <?= ($filters['status'] ?? '') === 'answered' ? 'active' : '' ?>">
            Đã phản hồi <span class="count"><?= (int)($answeredCount ?? 0) ?></span>
        </a>
    </div>
    <form method="GET" class="user-search-form">
        <?php if (!empty($filters['status'])): ?>
            <input type="hidden" name="status" value="<?= htmlspecialchars($filters['status']) ?>">
        <?php endif; ?>
        <div class="topbar-search user-search-wrap">
            <i class="bi bi-search"></i>
            <input type="text" name="search" value="<?= htmlspecialchars($filters['search'] ?? '') ?>" placeholder="Tìm theo tiêu đề, nội dung...">
        </div>
        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search"></i>Tìm</button>
    </form>
</div>

<div class="card">
    <div class="card-body ticket-table-card-body">
        <table class="data-table">
            <thead>
                <tr>
                    <th class="ticket-table-th">Mã Ticket</th>
                    <th class="ticket-table-th">Tiêu đề</th>
                    <?php if ($isAdmin): ?>
                    <th class="ticket-table-th">Người gửi</th>
                    <?php endif; ?>
                    <th class="ticket-table-th">Cập nhật lần cuối</th>
                    <th class="ticket-table-th">Trạng thái</th>
                    <th class="ticket-table-th--right">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                <?php if (empty($tickets)): ?>
                <tr>
                    <td colspan="<?= $isAdmin ? 6 : 5 ?>" class="ticket-table-empty">
                        <i class="bi bi-inbox ticket-table-empty-icon"></i>
                        Không có yêu cầu hỗ trợ nào.
                    </td>
                </tr>
                <?php else: ?>
                <?php foreach ($tickets as $t): ?>
                <?php [$statusLabel, $statusClass] = $statusMap[$t['status']] ?? ['Không rõ', 'badge-gray']; ?>
                <tr class="ticket-table-row">
                    <td class="ticket-table-td--muted">#<?= $t['id'] ?></td>
                    <td class="ticket-table-td--title"><?= htmlspecialchars($t['title']) ?></td>
                    <?php if ($isAdmin): ?>
                    <td class="ticket-table-td--secondary"><?= htmlspecialchars($t['author_name']) ?></td>
                    <?php endif; ?>
                    <td class="ticket-table-td--secondary"><?= date('d/m/Y H:i', strtotime($t['updated_at'])) ?></td>
                    <td class="ticket-table-td"><span class="badge <?= $statusClass ?>"><?= $statusLabel ?></span></td>
                    <td class="ticket-table-td--right">
                        <a href="<?= $this->url($routePrefix . '/ticket', ['action' => 'view', 'id' => $t['id']]) ?>" class="btn btn-sm btn-outline">
                            Chi tiết
                        </a>
                    </td>
                </tr>
                <?php endforeach; ?>
                <?php endif; ?>
            </tbody>
        </table>
    </div>
</div>

<!-- PAGINATION -->
<?php if ($totalPages > 1): ?>
<div class="catalog-pagination-bar" style="margin-top:20px; width: 100%;">
    <div class="catalog-pagination-info">
        Hiển thị <?= min(($page-1)*$perPage+1,$totalCount) ?> – <?= min($page*$perPage,$totalCount) ?> / <?= $totalCount ?> yêu cầu
    </div>
    <div class="pagination">
        <a class="page-btn <?= $page<=1?'disabled':'' ?>" href="<?= $page>1?$buildPageUrl($page-1):'#' ?>"><i class="bi bi-chevron-left"></i></a>
        <?php for ($p=max(1,$page-2); $p<=min($totalPages,$page+2); $p++): ?>
        <a class="page-btn <?= $p===$page?'active':'' ?>" href="<?= $buildPageUrl($p) ?>"><?= $p ?></a>
        <?php endfor; ?>
        <a class="page-btn <?= $page>=$totalPages?'disabled':'' ?>" href="<?= $page<$totalPages?$buildPageUrl($page+1):'#' ?>"><i class="bi bi-chevron-right"></i></a>
    </div>
</div>
<?php endif; ?>
