<?php
$this->headTitle('Hỗ trợ / Hỏi đáp');
$this->layout('layout/library-layout');
$authUser    = $this->currentUser();
$routePrefix = ($authUser['role'] ?? '') === 'admin' ? 'library' : 'student';

$statusMap = [
    'open' => ['Chưa phản hồi', 'badge-orange'],
    'in_progress' => ['Đã phản hồi', 'badge-green'],
    'closed' => ['Đã phản hồi', 'badge-green'],
    '' => ['Chưa phản hồi', 'badge-orange']
];
?>

<div class="page-header">
    <div>
        <div class="page-title">Hỗ trợ / Hỏi đáp</div>
        <div class="page-subtitle">Quản lý các yêu cầu hỗ trợ và trao đổi giữa Thư viện và Độc giả.</div>
    </div>
    <?php if (!$isAdmin): ?>
    <a href="<?= $this->url($routePrefix . '/ticket', ['action' => 'create']) ?>" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>Gửi yêu cầu mới
    </a>
    <?php endif; ?>
</div>

<div class="card">
    <div class="card-body ticket-table-card-body">
        <table class="data-table">
            <thead>
                <tr>
                    <th class="ticket-table-th">Mã Ticket</th>
                    <th class="ticket-table-th">Tiêu đề</th>
                    <?php if ($isAdmin): ?>
                    <th class="ticket-table-th">Người gửi</th>
                    <?php endif; ?>
                    <th class="ticket-table-th">Cập nhật lần cuối</th>
                    <th class="ticket-table-th">Trạng thái</th>
                    <th class="ticket-table-th--right">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                <?php if (empty($tickets)): ?>
                <tr>
                    <td colspan="<?= $isAdmin ? 6 : 5 ?>" class="ticket-table-empty">
                        <i class="bi bi-inbox ticket-table-empty-icon"></i>
                        Không có yêu cầu hỗ trợ nào.
                    </td>
                </tr>
                <?php else: ?>
                <?php foreach ($tickets as $t): ?>
                <?php [$statusLabel, $statusClass] = $statusMap[$t['status']] ?? ['Không rõ', 'badge-gray']; ?>
                <tr class="ticket-table-row">
                    <td class="ticket-table-td--muted">#<?= $t['id'] ?></td>
                    <td class="ticket-table-td--title"><?= htmlspecialchars($t['title']) ?></td>
                    <?php if ($isAdmin): ?>
                    <td class="ticket-table-td--secondary"><?= htmlspecialchars($t['author_name']) ?></td>
                    <?php endif; ?>
                    <td class="ticket-table-td--secondary"><?= date('d/m/Y H:i', strtotime($t['updated_at'])) ?></td>
                    <td class="ticket-table-td"><span class="badge <?= $statusClass ?>"><?= $statusLabel ?></span></td>
                    <td class="ticket-table-td--right">
                        <a href="<?= $this->url($routePrefix . '/ticket', ['action' => 'view', 'id' => $t['id']]) ?>" class="btn btn-sm btn-outline">
                            Chi tiết
                        </a>
                    </td>
                </tr>
                <?php endforeach; ?>
                <?php endif; ?>
            </tbody>
        </table>
    </div>
</div>
