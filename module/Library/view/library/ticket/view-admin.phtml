<?php
$this->headTitle('Chi tiết Ticket #' . $ticket['id']);
$this->layout('layout/library-layout');
$authUser    = $this->currentUser();
$routePrefix = 'library';

$statusMap = [
    'open'        => ['Chưa phản hồi', 'badge-orange'],
    'in_progress' => ['Đã phản hồi',   'badge-green'],
    'closed'      => ['Đã phản hồi',   'badge-green'],
    ''            => ['Chưa phản hồi', 'badge-orange']
];
[$statusLabel, $statusClass] = $statusMap[$ticket['status']] ?? ['Không rõ', 'badge-gray'];
$isClosed = false; // Always allow reply since ticket closing is removed
?>

<div class="page-header">
    <div class="d-flex align-center gap-3">
        <a href="<?= $this->url($routePrefix . '/ticket') ?>" class="btn btn-outline btn-icon"><i class="bi bi-arrow-left"></i></a>
        <div>
            <div class="page-title">Ticket #<?= $ticket['id'] ?> - <?= htmlspecialchars($ticket['title']) ?></div>
            <div class="page-subtitle">Bởi: <?= htmlspecialchars($ticket['author_name']) ?> | Trạng thái: <span class="badge <?= $statusClass ?> ticket-view-status-badge"><?= $statusLabel ?></span></div>
        </div>
    </div>
</div>

<div class="card ticket-view-card">
    <div class="card-body ticket-view-card-body">
        <div class="ticket-msg-list">
            <?php foreach ($messages as $msg): ?>
            <?php $isOwn = $msg['sender_id'] == $currentUser['id']; ?>
            <?php $isSystemAdmin = $msg['role'] === 'admin'; ?>
            
            <div class="ticket-msg-row <?= $isOwn ? 'ticket-msg-row--own' : 'ticket-msg-row--other' ?>">
                <div class="ticket-msg-meta">
                    <?php if (!$isOwn): ?>
                        <span class="ticket-msg-username"><?= htmlspecialchars($msg['full_name']) ?></span>
                        <?php if ($isSystemAdmin): ?><span class="badge badge-orange ticket-msg-badge-admin">Admin</span><?php endif; ?>
                        <span>•</span>
                    <?php endif; ?>
                    <?= date('d/m/Y H:i', strtotime($msg['sent_at'])) ?>
                </div>
                
                <div class="ticket-msg-bubble <?= $isOwn ? 'ticket-msg-bubble--own' : 'ticket-msg-bubble--other' ?>">
                    <?= nl2br(htmlspecialchars($msg['message'])) ?>
                </div>
            </div>
            <?php endforeach; ?>
        </div>
    </div>
</div>

<?php if (!$isClosed): ?>
<div class="card ticket-reply-card">
    <div class="card-body">
        <form method="POST">
            <input type="hidden" name="action" value="reply">
            <div class="form-group ticket-form-group">
                <textarea name="message" class="form-control" rows="4" placeholder="Nhập phản hồi của bạn..." required></textarea>
            </div>
            <div class="text-right">
                <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i>Gửi phản hồi</button>
            </div>
        </form>
    </div>
</div>
<?php else: ?>
<div class="alert alert-info ticket-alert-closed">
    <i class="bi bi-info-circle-fill"></i> Yêu cầu hỗ trợ này đã được đóng. Bạn không thể gửi thêm phản hồi.
</div>
<?php endif; ?>
