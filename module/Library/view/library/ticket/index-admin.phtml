$perPageRaw = $pagination['perPage'] ?? '20';
$totalItems = (int) ($pagination['totalItems'] ?? 0);
$totalPages = (int) ($pagination['totalPages'] ?? 1);

$buildPageUrl = function(int $p) use ($filters, $routePrefix, $perPageRaw): string {
    $q = array_merge($filters, ['page' => $p, 'perPage' => $perPageRaw]);
    return $this->url($routePrefix . '/ticket', [], ['query' => array_filter($q)]);
};

$buildTabUrl = function(string $statusVal) use ($filters, $routePrefix, $perPageRaw): string {
    $q = array_merge($filters, ['status' => $statusVal, 'page' => 1, 'perPage' => $perPageRaw]);
    return $this->url($routePrefix . '/ticket', [], ['query' => array_filter($q)]);
};

$buildSortUrl = function(string $col) use ($filters, $routePrefix, $perPageRaw): string {
    $currentSort = $filters['sort'] ?? 'id';
    $currentDir  = strtoupper($filters['direction'] ?? 'ASC');
    $newDir = ($currentSort === $col && $currentDir === 'ASC') ? 'DESC' : 'ASC';
    $q = array_merge($filters, ['sort' => $col, 'direction' => $newDir, 'page' => 1, 'perPage' => $perPageRaw]);
    return $this->url($routePrefix . '/ticket', [], ['query' => array_filter($q)]);
};

$renderSortIcon = function(string $col) use ($filters): string {
    $currentSort = $filters['sort'] ?? 'id';
    $currentDir  = strtoupper($filters['direction'] ?? 'ASC');
    if ($currentSort !== $col) return '<i class="bi bi-arrow-down-up ms-1" style="font-size: 0.7rem; opacity: 0.3;"></i>';
    return $currentDir === 'ASC' ? '<i class="bi bi-sort-down ms-1 text-primary"></i>' : '<i class="bi bi-sort-up ms-1 text-primary"></i>';
};
