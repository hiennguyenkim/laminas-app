<?php $this->headTitle('Quên mật khẩu');
$this->layout('layout/library-layout'); 

$publicDir = getcwd();
if (basename($publicDir) !== 'public') {
    $publicDir .= '/public';
}
$customLogoFile = null;
foreach (['logo.png','logo.jpg','logo.jpeg','logo.svg','logo.webp'] as $_lf) {
    if (file_exists($publicDir . '/img/uploads/' . $_lf)) {
        $customLogoFile = 'img/uploads/' . $_lf; break;
    }
}
?>
<div class="login-card">
    <a href="<?= $this->url('library/auth', ['action' => 'login']) ?>" class="btn btn-outline btn-icon" style="position: absolute; top: 20px; left: 20px;" title="Quay lại trang đăng nhập">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div class="login-logo">
        <?php if ($customLogoFile): ?>
            <img src="<?= $this->basePath($customLogoFile) ?>?t=<?= filemtime($publicDir . '/' . $customLogoFile) ?>" alt="Logo">
        <?php else: ?>
            <i class="bi bi-question-circle" style="color: var(--accent-purple, #7c6aff); font-size: 40px;"></i>
        <?php endif; ?>
    </div>
    <div class="login-title">Quên mật khẩu</div>
    <div class="login-sub">Nhập tên đăng nhập hoặc email để nhận mã OTP khôi phục mật khẩu</div>

    <form method="POST" action="<?= $this->url('library/auth', ['action' => 'forgotPassword']) ?>">
        <div class="form-group" style="margin-bottom: 24px;">
            <label class="form-label">Tên đăng nhập hoặc Email</label>
            <input type="text" name="identity" class="form-control" placeholder="Nhập tên đăng nhập hoặc email..." autofocus required>
        </div>
        
        <button type="submit" class="btn btn-primary w-100 login-btn" style="height: 44px; font-weight: 600;">
            <i class="bi bi-envelope-fill"></i> Gửi mã OTP
        </button>
    </form>
    
    <p class="login-footer-text" style="margin-top: 24px;">
        Quay lại
        <a href="<?= $this->url('library/auth', ['action' => 'login']) ?>" class="login-footer-link">Đăng nhập</a>
    </p>
    <div class="login-copyright" style="margin-top: 30px;">
