<script>
function togglePasswordVisibility(inputId, btnEl) {
    const input = document.getElementById(inputId);
    const icon = btnEl.querySelector('i');
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('bi-eye');
        icon.classList.add('bi-eye-slash');
    } else {
        input.type = 'password';
        icon.classList.remove('bi-eye-slash');
        icon.classList.add('bi-eye');
    }
}

document.addEventListener('DOMContentLoaded', () => {
    const digits = document.querySelectorAll('.otp-digit');
    const hiddenCode = document.getElementById('hidden-otp-code');
    const form = document.getElementById('otp-form');

    // Auto focus traversal
    digits.forEach((el, index) => {
        el.addEventListener('input', (e) => {
            const val = e.target.value;
            e.target.value = val.replace(/[^0-9]/g, '');

            if (e.target.value !== '' && index < digits.length - 1) {
                digits[index + 1].focus();
            }
            updateHiddenCode();
        });

        el.addEventListener('keydown', (e) => {
            if (e.key === 'Backspace' && e.target.value === '' && index > 0) {
                digits[index - 1].focus();
            }
        });

        el.addEventListener('paste', (e) => {
            e.preventDefault();
            const text = (e.clipboardData || window.clipboardData).getData('text').trim();
            if (/^\d{6}$/.test(text)) {
                digits.forEach((digitEl, i) => {
                    digitEl.value = text[i];
                });
                updateHiddenCode();
                digits[digits.length - 1].focus();
            }
        });
    });

    function updateHiddenCode() {
        let code = '';
        digits.forEach(el => {
            code += el.value;
        });
        hiddenCode.value = code;
    }

    form.addEventListener('submit', (e) => {
        updateHiddenCode();
        if (hiddenCode.value.length !== 6) {
            e.preventDefault();
            alert('Vui lòng nhập đầy đủ 6 chữ số của mã xác thực.');
            return;
        }

        const newPass = document.getElementById('new-password').value;
        const confirmPass = document.getElementById('confirm-password').value;
        if (newPass.length < 8) {
            e.preventDefault();
            alert('Mật khẩu mới phải có độ dài từ 8 ký tự trở lên.');
            return;
        }
        if (!/[A-Z]/.test(newPass)) {
            e.preventDefault();
            alert('Mật khẩu mới phải chứa ít nhất một ký tự in hoa.');
            return;
        }
        if (!/[^a-zA-Z0-9\s]/.test(newPass)) {
            e.preventDefault();
            alert('Mật khẩu mới phải chứa ít nhất một ký tự đặc biệt.');
            return;
        }
        if (newPass !== confirmPass) {
            e.preventDefault();
            alert('Mật khẩu mới và xác nhận mật khẩu không khớp.');
            return;
        }
    });

    // Resend countdown timer
    let count = 60;
    const timerEl = document.getElementById('timer');
    const wrapperEl = document.getElementById('countdown-wrapper');
    const linkEl = document.getElementById('resend-link');

    const interval = setInterval(() => {
        count--;
        if (count <= 0) {
            clearInterval(interval);
            wrapperEl.style.display = 'none';
            linkEl.style.display = 'inline';
        } else {
            timerEl.textContent = count;
        }
    }, 1000);
});
</script>
